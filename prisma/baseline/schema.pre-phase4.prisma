  contactPhone   String?
  status         String            @default("scheduled")
  cancelReason   String?
  assignedToId   String
  createdById    String
  notifiedAt     DateTime?
  reminderSentAt DateTime?
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime          @default(now())
