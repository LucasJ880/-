  TenderRequirement          TenderRequirement            @relation(fields: [tenderRequirementId], references: [id], onDelete: Cascade)
  ComplianceResponseEvidence ComplianceResponseEvidence[]

  @@unique([bidDataRevisionId, stableKey])
  @@unique([bidDataRevisionId, tenderRequirementId])
  @@index([bidDataRevisionId])
  @@index([projectId])
  @@index([reviewStatus])
  @@index([sourceAgentRunId])
  @@index([status])
  @@index([tenderRequirementId])
}

