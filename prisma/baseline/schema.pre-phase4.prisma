  @@index([bidDataRevisionId])
  @@index([category])
  @@index([deletedAt])
  @@index([projectId])
  @@index([reviewStatus])
  @@index([sourceAgentRunId])
  @@index([sourceDocumentId])
}

/// Security-1：企业访问模式
/// FIXED = 普通员工锁定企业；MULTI_ORG = 可在设置中切换；PLATFORM_SUPPORT = 平台支持（本阶段仅占位）
enum OrgAccessMode {
  FIXED
  MULTI_ORG
  PLATFORM_SUPPORT
}


