model BidDataRevision {
  id                        String               @id
  projectId                 String
  revisionNumber            Int
  title                     String?
  status                    String               @default("DRAFT")
  sourceRootTaskId          String?
  sourceTenderRunId         String?
  sourceProductRunId        String?
  sourceComplianceRunId     String?
  sourcePricingRunId        String?
  sourceDocumentQaRunId     String?
  projectionVersion         String
  projectionHash            String
  technicalReadiness        String               @default("BLOCKED")
  financialReadiness        String               @default("BLOCKED")
  blockingIssueCount        Int                  @default(0)
  warningCount              Int                  @default(0)
  issuesJson                Json?
  origin                    String               @default("AGENT_PROJECTION")
  createdByUserId           String?
  reviewedByUserId          String?
  approvedByUserId          String?
  lockedByUserId            String?
  reviewedAt                DateTime?
  approvedAt                DateTime?
  lockedAt                  DateTime?
  supersedesRevisionId      String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime
  technicalReviewStatus     String               @default("NOT_STARTED")
  financialReviewStatus     String               @default("NOT_STARTED")
  submittedByUserId         String?
  submittedAt               DateTime?
  technicalApprovedByUserId String?
  technicalApprovedAt       DateTime?
  financialApprovedByUserId String?
  financialApprovedAt       DateTime?
  rejectedByUserId          String?
  rejectedAt                DateTime?
  rejectReason              String?
  revisionContentHash       String?
  Project                   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  BidDataRevision           BidDataRevision?     @relation("BidDataRevisionToBidDataRevision", fields: [supersedesRevisionId], references: [id])
  other_BidDataRevision     BidDataRevision[]    @relation("BidDataRevisionToBidDataRevision")
  ComplianceResponse        ComplianceResponse[]
  PricingScenario           PricingScenario[]
  ProductEvidence           ProductEvidence[]
  TenderRequirement         TenderRequirement[]

  @@unique([projectId, projectionHash])
  @@unique([projectId, revisionNumber])
  @@index([projectId, createdAt])
  @@index([projectId, status])
  @@index([sourceRootTaskId])
  @@index([status])
}

model ComplianceResponse {
  id                         String                       @id
  projectId                  String
  bidDataRevisionId          String
  tenderRequirementId        String
  stableKey                  String
  status                     String
  proposedResponse           String?
  rationale                  String?
