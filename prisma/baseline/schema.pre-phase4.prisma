  AgentTask_AgentTaskDependency_dependsOnTaskIdToAgentTask AgentTask @relation("AgentTaskDependency_dependsOnTaskIdToAgentTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  AgentTask_AgentTaskDependency_taskIdToAgentTask          AgentTask @relation("AgentTaskDependency_taskIdToAgentTask", fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
