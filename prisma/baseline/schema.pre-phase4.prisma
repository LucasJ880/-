/// 组织级产品主档（动态 attributes，行业字段由 Industry Pack 定义）
model TradeProduct {
  id            String              @id @default(cuid())
  orgId         String
  sku           String
  name          String
  nameEn        String?
  brand         String?
  category      String?
  collection    String?
  modelNumber   String?
  industryPack  String              @default("home_textile")
  geometryClass String              @default("DEFORMABLE_SURFACE")
  attributes    Json                @default("{}")
  status        String              @default("draft")
  createdById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  assets        ProductAsset[]
  jobs          ProductContentJob[]
  facts         ProductFact[]
  org           Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, sku])
  @@index([orgId, category])
  @@index([orgId, status])
}

model ProductAsset {
  id             String             @id @default(cuid())
  orgId          String
  productId      String?
  jobId          String?
  roleAuto       String             @default("unknown")
  roleConfirmed  String?
