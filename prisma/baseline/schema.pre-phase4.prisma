  incomingValue  Json?
  status         String            @default("open")
  resolution     String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  currentFact    ProductFact?      @relation("ConflictCurrent", fields: [currentFactId], references: [id])
  incomingFact   ProductFact?      @relation("ConflictIncoming", fields: [incomingFactId], references: [id])
  job            ProductContentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([orgId, jobId, status])
}

model ProductContentJob {
