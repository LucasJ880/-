  sourceChannel    String?
  externalUserId   String?
  bindingId        String?
  createdById      String?
  assigneeId       String?
  assignedAt       DateTime?
  deliveredAt      DateTime?
  closedAt         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  assets           TradeServiceAsset[]

  @@index([orgId, status])
  @@index([orgId, createdAt])
  @@index([fulfillmentOrgId, status])
  @@index([assigneeId])
}

