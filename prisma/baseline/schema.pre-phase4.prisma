  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  job            ProductContentJob? @relation(fields: [jobId], references: [id])
  product        TradeProduct?      @relation(fields: [productId], references: [id])

  @@index([orgId, productId])
  @@index([orgId, jobId])
}

model ProductFact {
  id                  String                @id @default(cuid())
  orgId               String
  productId           String?
  jobId               String?
  fieldKey            String
  value               Json
  normalizedValue     Json?
  sourceType          String
  sourceId            String?
  sourceLocation      String?
  confidence          Float                 @default(0.5)
  status              String                @default("extracted")
  confirmedById       String?
  confirmedAt         DateTime?
  locked              Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  job                 ProductContentJob?    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  product             TradeProduct?         @relation(fields: [productId], references: [id])
  conflictsAsCurrent  ProductFactConflict[] @relation("ConflictCurrent")
  conflictsAsIncoming ProductFactConflict[] @relation("ConflictIncoming")

  @@index([orgId, jobId, fieldKey])
  @@index([orgId, productId, fieldKey])
  @@index([orgId, status])
}

model ProductFactConflict {
  id             String            @id @default(cuid())
  orgId          String
  jobId          String
  fieldKey       String
  currentFactId  String?
  incomingFactId String?
