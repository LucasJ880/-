  userId              String
  channel             String
  language            String
  scene               String
  sceneLabel          String
  content             String
  example             String?
  effectiveness       Int                    @default(0)
  sourceInteractionId String?
  tags                String?
  status              String                 @default("active")
  usageCount          Int                    @default(0)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  embedding           Unsupported("vector")?
  sourceType          String?

  @@index([userId, channel])
  @@index([userId, scene])
  @@index([userId, status])
}

/// 销售 FAQ — 客户常见问题 + 最佳回答
model SalesFAQ {
  id                  String                 @id @default(cuid())
  userId              String
  question            String
  answer              String
  language            String
  category            String
  categoryLabel       String
  productTags         String?
  frequency           Int                    @default(1)
  sourceInteractionId String?
  status              String                 @default("active")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  embedding           Unsupported("vector")?

  @@index([userId, category])
  @@index([userId, language])
  @@index([userId, status])
}

/// 用户级 AI 记忆条目 — 跨对话、跨项目的持久知识
/// 强制 orgId 隔离：同一用户在不同组织的记忆互不召回
model UserMemory {
  id             String    @id @default(cuid())
  userId         String
  memoryType     String
  layer          Int       @default(1)
  content        String
  tags           String?
  sourceThreadId String?
  customerId     String?
  projectId      String?
  importance     Int       @default(3)
  accessCount    Int       @default(0)
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  embedding      Json?
  supersededById String?
  /// 所属组织（必填）。禁止跨组织读写记忆。
  orgId          String
  supersedesId   String?
  /// 生效起点；存量回填为 createdAt
  effectiveFrom  DateTime  @default(now())
  /// 失效终点；null 表示仍生效
  effectiveTo    DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, userId, layer])
  @@index([orgId, userId, memoryType])
  @@index([orgId, userId, importance])
  @@index([orgId, userId, tags])
  @@index([orgId, userId, customerId])
  @@index([orgId, userId, projectId])
  @@index([orgId, userId, effectiveTo])
  @@index([userId, layer])
  @@index([supersedesId])
  @@index([supersededById])
}

/// AI 动态技能 — 可在运行时创建、修改、自我优化的能力单元
model AgentSkill {
  id                 String              @id @default(cuid())
  orgId              String
  name               String
  slug               String
  description        String
  domain             String
  tier               String              @default("foundation")
  systemPrompt       String
  userPromptTemplate String
  outputFormat       String              @default("text")
  temperature        Float               @default(0.3)
  maxTokens          Int                 @default(2000)
  inputSchema        Json?
  outputSchema       Json?
  requiredTools      String?
  version            Int                 @default(1)
  isBuiltin          Boolean             @default(false)
  isActive           Boolean             @default(true)
  createdById        String?
  lastOptimizedAt    DateTime?
  optimizationCount  Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdBy          User?               @relation("AgentSkillCreatedBy", fields: [createdById], references: [id])
  org                Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions           AgentSkillVersion[]
  executions         SkillExecution[]

  @@unique([orgId, slug])
  @@index([orgId, domain])
  @@index([orgId, isActive])
}

/// 技能执行记录 — 每次 AgentSkill 运行的输入/输出/评分
model SkillExecution {
  id             String     @id @default(cuid())
  skillId        String
  userId         String
  inputJson      String
  outputJson     String?
  toolCalls      Json?
  success        Boolean    @default(true)
  durationMs     Int?
  tokenCount     Int?
  userRating     Int?
  userFeedback   String?
  wasEdited      Boolean    @default(false)
  promptSnapshot String?
  createdAt      DateTime   @default(now())
  skill          AgentSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId, createdAt])
  @@index([skillId, success])
  @@index([skillId, userRating])
}

/// 统一消息嵌入索引 — 跨所有会话类型的语义搜索
model MessageEmbedding {
  id           String   @id @default(cuid())
  userId       String
  orgId        String?
  sourceType   String
  sourceId     String
  sessionId    String
  sessionTitle String?
  role         String
  content      String
  embedding    Json
  createdAt    DateTime @default(now())

  @@unique([sourceType, sourceId])
  @@index([userId, sourceType])
  @@index([orgId, sourceType])
  @@index([userId, createdAt])
}

/// 会话摘要 — 长对话压缩后的持久化摘要
model ConversationSummary {
  id            String   @id @default(cuid())
  userId        String
  sourceType    String
  sessionId     String
  sessionTitle  String?
  summary       String
  keyTopics     String?
  keyDecisions  String?
  messageCount  Int
  tokenEstimate Int?
  embedding     Json?
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([sourceType, sessionId])
  @@index([userId, sourceType])
  @@index([userId, updatedAt])
}

/// 微信绑定 — 微信用户 ID 与青砚用户的映射
model WeChatBinding {
  id            String    @id @default(cuid())
  userId        String
  orgId         String?
  channel       String
  externalId    String
  displayName   String?
  avatarUrl     String?
  status        String    @default("active")
  lastActiveAt  DateTime?
  pushBriefing  Boolean   @default(true)
  pushFollowup  Boolean   @default(true)
  pushReport    Boolean   @default(true)
  pushSales     Boolean   @default(false)
  silentStart   String?
  silentEnd     String?
  pushDomains   String    @default("trade")
  filterMode    String    @default("all")
  filterKeyword String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation("UserWeChatBindings", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channel, externalId])
  @@index([userId])
  @@index([channel, status])
}

/// 微信网关连接 — 个人微信 Bot / 企业微信应用的连接实例
model WeChatGateway {
  id               String    @id @default(cuid())
  orgId            String
  channel          String
  botNickname      String?
  loginStatus      String    @default("disconnected")
  corpId           String?
  agentId          String?
  secret           String?
  callbackToken    String?
  encodingKey      String?
  status           String    @default("inactive")
  lastHeartbeat    DateTime?
  errorMessage     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  botBaseUrl       String?
  botToken         String?
  getUpdatesBuf    String?
  mode             String    @default("assistant")
  fulfillmentOrgId String?

  @@unique([orgId, channel])
}

/// 微信会话上下文令牌（iLink context_token）
///
/// iLink 为被动回复：每条出站消息必须回传入站消息携带的 context_token，否则无法路由到正确会话。
/// 持久化到 DB，使「常驻 worker 进程」收消息后，「Vercel 控制台进程」也能用最新 token 回传交付物。
model WeChatContext {
  id             String   @id @default(cuid())
  orgId          String
  channel        String
  externalUserId String
  contextToken   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([orgId, channel, externalUserId])
  @@index([orgId, channel])
}

/// 微信 Grader 短期上下文记忆（按 用户 + 渠道 维度；TTL 30 分钟）
/// 仅存最近一次 Grader / 目标对象的 id/name，用于解析「这个客户/项目/报价」等指代。
/// 不存正文；过期不使用；严格按 orgId + userId + channel 隔离。
model WeChatGraderContext {
  id             String   @id @default(cuid())
  orgId          String
  userId         String
  channel        String
  externalUserId String?
  contextData    Json
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([orgId, userId, channel])
  @@index([userId])
}

/// 微信消息记录
model WeChatMessage {
  id             String   @id @default(cuid())
  bindingId      String
  userId         String
  orgId          String?
  direction      String
  channel        String
  externalUserId String
  content        String
  messageType    String   @default("text")
  externalMsgId  String?
  agentProcessed Boolean  @default(false)
  agentResponse  String?
  createdAt      DateTime @default(now())

  @@index([bindingId, createdAt])
  @@index([userId, createdAt])
  @@index([channel, createdAt])
  @@index([orgId, channel, externalMsgId])
}

/// Agent 渠道会话（微信/企微等）— 多轮复用，带 org 隔离
/// 不存完整聊天；原文仍在 WeChatMessage。summary 仅为压缩摘要。
model AgentSession {
  id                    String     @id @default(cuid())
  orgId                 String
  userId                String?
  channel               String
  channelUserId         String?
  channelConversationId String?
  currentProjectId      String?
  currentCustomerId     String?
  currentOpportunityId  String?
  currentQuoteId        String?
  lastResponseId        String?
  summary               String?
  status                String     @default("active")
  lastActiveAt          DateTime   @default(now())
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  runs                  AgentRun[]

  @@index([orgId, userId])
  @@index([orgId, channel, channelConversationId])
  @@index([orgId, channel, channelUserId, status])
}

/// 单次 AI 处理任务（含后台队列租约，对标 MarketResearchRun）
model AgentRun {
  id              String                 @id @default(cuid())
  orgId           String
  sessionId       String
  userMessageId   String?
  runType         String                 @default("conversation")
  status          String                 @default("queued")
  model           String?
  intent          String?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  latencyMs       Int?
  errorCode       String?
  errorMessage    String?
  metadata        Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  /// 后台消费：尝试次数
  attempts        Int                    @default(0)
  /// 租约过期时间（running 超时可被重新认领）
  leaseExpiresAt  DateTime?
  /// 下次可尝试时间（退避重试）
  nextAttemptAt   DateTime?
  /// 主管 AI Supervisor 持久化状态（与 metadata.background 隔离）
  supervisorState Json?
  /// Phase 3A：跨执行关联；历史可空，新执行应写入
  traceId         String?
  /// Phase 3A：父 Run（可选）
  parentRunId     String?
  /// Agent Runtime 2.0：Planner 结构化计划（与 supervisorState 隔离）
  planJson        Json?
  /// Agent Runtime 版本标记：空/v1=旧 Runtime；v2=AR2 durable graph
  runtimeVersion  String?
  agentTaskId     String?
  AgentTask       AgentTask?             @relation(fields: [agentTaskId], references: [id])
  session         AgentSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  events          AgentRunEvent[]
  steps           AgentRunStep[]
  verifications   AgentRunVerification[]

  @@index([orgId, sessionId])
  @@index([orgId, status])
  @@index([orgId, userMessageId])
  @@index([orgId, traceId])
  @@index([orgId, runtimeVersion, status])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([agentTaskId])
}

/// Agent Runtime 2.0 — 持久化步骤（依赖图 + 证据，挂在 AgentRun 下）
model AgentRunStep {
  id               String    @id @default(cuid())
  orgId            String
  runId            String
  stepKey          String
  title            String
  description      String?
  status           String    @default("pending")
  /// JSON string[] of stepKey dependencies
  dependsOnJson    Json      @default("[]")
  preferredTool    String?
  executionMode    String    @default("read")
  riskLevel        String    @default("LOW")
  requiresApproval Boolean   @default(false)
  attemptCount     Int       @default(0)
  maxAttempts      Int       @default(2)
  inputJson        Json?
  outputJson       Json?
  evidenceJson     Json?
  pendingActionId  String?
  errorCode        String?
  errorMessage     String?
  /// 幂等键：ar2:{runId}:{stepKey}:{attempt}
  idempotencyKey   String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  run              AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stepKey])
  @@unique([orgId, idempotencyKey])
  @@index([orgId, runId])
  @@index([runId, status])
  @@index([orgId, pendingActionId])
}

/// Agent Runtime 2.0 — Verifier 结果与 Repair 历史
model AgentRunVerification {
  id                      String   @id @default(cuid())
  orgId                   String
  runId                   String
  attempt                 Int
  verdict                 String
  summary                 String
  satisfiedCriteriaJson   Json     @default("[]")
  unsatisfiedCriteriaJson Json     @default("[]")
  evidenceReferencesJson  Json     @default("[]")
  repairInstructionsJson  Json     @default("[]")
  createdAt               DateTime @default(now())
  run                     AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, attempt])
  @@index([orgId, runId])
}

/// AgentRun 真实执行进度事件（不伪造「正在思考」）
model AgentRunEvent {
  id            String   @id @default(cuid())
  orgId         String
  runId         String
  sequence      Int
  eventType     String
  title         String?
  payload       Json?
  visibleToUser Boolean  @default(true)
  createdAt     DateTime @default(now())
  run           AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([orgId, runId])
}

/// 客服会话 — 未绑定的外部联系人（客户）发给机器人微信号的会话
///
/// 与 WeChatMessage（内部员工 AI 助理通道）分开建模：
/// 客户没有青砚账号，会话以 orgId + channel + externalUserId 唯一标识。
/// unansweredSince / reminderLevel 驱动「未回复超时提醒」SLA 扫描。
model ServiceConversation {
  id                    String           @id @default(cuid())
  orgId                 String
  channel               String
  externalUserId        String
  displayName           String?
  status                String           @default("open")
  lastCustomerMessageAt DateTime?
  lastReplyAt           DateTime?
  /// 当前未回复起点（客服回复或标记已处理后清空）
  unansweredSince       DateTime?
  /// SLA 提醒等级：0 未提醒 / 1 一级已提醒 / 2 升级已提醒
  reminderLevel         Int              @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  messages              ServiceMessage[]

  @@unique([orgId, channel, externalUserId])
  @@index([orgId, status, unansweredSince])
  @@index([orgId, lastCustomerMessageAt])
}

/// 客服会话消息
model ServiceMessage {
  id             String              @id @default(cuid())
  conversationId String
  orgId          String
  direction      String
  content        String
  messageType    String              @default("text")
  externalMsgId  String?
  /// outbound：在青砚中发送回复的用户
  sentByUserId   String?
  createdAt      DateTime            @default(now())
  conversation   ServiceConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([orgId, createdAt])
}

/// 销售知识分块 — 沟通内容经 AI 分析后的语义分块
model SalesKnowledgeChunk {
  id            String                 @id @default(cuid())
  sourceType    String
  sourceId      String?
  customerId    String?
  opportunityId String?
  interactionId String?
  content       String
  embedding     Unsupported("vector")?
  metadata      Json?
  tags          String[]
  language      String                 @default("en")
  sentiment     String?
  intent        String?
  objectionType String?
  isWinPattern  Boolean                @default(false)
  isLossSignal  Boolean                @default(false)
  createdAt     DateTime               @default(now())
  customer      SalesCustomer?         @relation(fields: [customerId], references: [id])
  interaction   CustomerInteraction?   @relation(fields: [interactionId], references: [id])
  opportunity   SalesOpportunity?      @relation(fields: [opportunityId], references: [id])

  @@index([customerId])
  @@index([opportunityId])
  @@index([interactionId])
  @@index([sourceType])
  @@index([isWinPattern])
  @@index([isLossSignal])
  @@index([intent])
}

/// 销售洞察 — AI 提炼的赢单/丢单模式与最佳实践
model SalesInsight {
  id              String                 @id @default(cuid())
  userId          String
  insightType     String
  title           String
  description     String
  embedding       Unsupported("vector")?
  dealStage       String?
  productType     String?
  customerTags    String[]
  objectionType   String?
  effectiveness   Float                  @default(0)
  usageCount      Int                    @default(0)
  successCount    Int                    @default(0)
  sourceChunkIds  String[]
  status          String                 @default("active")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  coachingRecords CoachingRecord[]
  user            User                   @relation("SalesInsightUser", fields: [userId], references: [id])

  @@index([insightType])
  @@index([dealStage])
  @@index([status])
  @@index([effectiveness])
}

/// 客户画像 — AI 自动生成的结构化画像（销售 + Marketing 预留）
model CustomerProfile {
  id                     String                 @id @default(cuid())
  customerId             String                 @unique
  customerType           String?
  decisionRole           String?
  budgetRange            String?
  priceSensitivity       Float?
  communicationStyle     String?
  preferredChannel       String?
  responseSpeed          String?
  decisionSpeed          String?
  productPreferences     String[]
  roomTypes              String[]
  keyNeeds               String[]
  objectionHistory       String[]
  winProbability         Float?
  estimatedLifetimeValue Float?
  churnRisk              Float?
  acquisitionChannel     String?
  referralSource         String?
  contentEngagement      Json?
  segment                String?
  campaignIds            String[]
  confidence             Float                  @default(0)
  lastAnalyzedAt         DateTime?
  analysisVersion        Int                    @default(1)
  embedding              Unsupported("vector")?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  customer               SalesCustomer          @relation(fields: [customerId], references: [id])

  @@index([customerType])
  @@index([segment])
  @@index([budgetRange])
  @@index([winProbability])
}

/// 教练记录 — 记录每次 AI 建议及后续效果，用于自我训练
model CoachingRecord {
  id                String            @id @default(cuid())
  userId            String
  customerId        String
  opportunityId     String?
  insightId         String?
  coachingType      String
  recommendation    String
  context           Json?
  adopted           Boolean?
  adoptedAt         DateTime?
  outcome           String?
  outcomeAt         DateTime?
  daysToOutcome     Int?
  dealValue         Float?
  contributionScore Float?
  createdAt         DateTime          @default(now())
  customer          SalesCustomer     @relation(fields: [customerId], references: [id])
  insight           SalesInsight?     @relation(fields: [insightId], references: [id])
  opportunity       SalesOpportunity? @relation(fields: [opportunityId], references: [id])
  user              User              @relation("CoachingRecordUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([customerId])
  @@index([opportunityId])
  @@index([insightId])
  @@index([outcome])
  @@index([coachingType])
}

/// 一次客户/机会下的可视化方案工作区
model VisualizerSession {
  id                  String                  @id @default(cuid())
  title               String                  @default("可视化方案")
  status              String                  @default("draft")
  customerId          String
  opportunityId       String?
  quoteId             String?
  measurementRecordId String?
  createdById         String
  salesOwnerId        String?
  shareToken          String?                 @unique
  shareExpiresAt      DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  createdBy           User                    @relation("VisualizerSessionCreatedBy", fields: [createdById], references: [id])
  customer            SalesCustomer           @relation(fields: [customerId], references: [id])
  measurementRecord   MeasurementRecord?      @relation(fields: [measurementRecordId], references: [id])
  opportunity         SalesOpportunity?       @relation(fields: [opportunityId], references: [id])
  quote               SalesQuote?             @relation(fields: [quoteId], references: [id])
  salesOwner          User?                   @relation("VisualizerSessionSalesOwner", fields: [salesOwnerId], references: [id])
  sourceImages        VisualizerSourceImage[]
  variants            VisualizerVariant[]

  @@index([customerId])
  @@index([opportunityId])
  @@index([quoteId])
  @@index([salesOwnerId])
  @@index([createdById, createdAt])
}

/// 客户/销售上传的现场原始照片
model VisualizerSourceImage {
  id                 String                   @id @default(cuid())
  sessionId          String
  /// 弱耦合：可回链到 MeasurementPhoto.id，避免重复上传；不做 FK
  measurementPhotoId String?
  fileUrl            String
  fileName           String
  mimeType           String
  width              Int?
  height             Int?
  bytes              Int?
  roomLabel          String?
  note               String?
  createdAt          DateTime                 @default(now())
  session            VisualizerSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  regions            VisualizerWindowRegion[]

  @@index([sessionId])
}

/// 一张原图上标记的窗户区域（1 张图可标多个窗）
model VisualizerWindowRegion {
  id                  String                    @id @default(cuid())
  sourceImageId       String
  /// 弱耦合：可与 MeasurementWindow.id 绑定，自动带入尺寸
  measurementWindowId String?
  label               String?
  shape               String                    @default("polygon")
  /// polygon: [[x,y], ...]; rect: [[x,y],[x2,y2]]; 坐标系=原图像素
  pointsJson          Json
  widthIn             Float?
  heightIn            Float?
  createdAt           DateTime                  @default(now())
  productOptions      VisualizerProductOption[]
  sourceImage         VisualizerSourceImage     @relation(fields: [sourceImageId], references: [id], onDelete: Cascade)

  @@index([sourceImageId])
}

/// 方案（Option A / Option B / Blackout Version ...）
model VisualizerVariant {
  id             String                    @id @default(cuid())
  sessionId      String
  name           String
  notes          String?
  /// 导出的 PNG URL（快照/分享/邮件用）
  exportImageUrl String?
  sortOrder      Int                       @default(0)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  productOptions VisualizerProductOption[]
  selections     VisualizerSelection[]
  session        VisualizerSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, sortOrder])
}

/// 方案中某扇窗使用的产品（颜色/透明度/叠加变换）
model VisualizerProductOption {
  id               String                 @id @default(cuid())
  variantId        String
  regionId         String
  /// Mock 阶段：指向 src/lib/visualizer/mock-products.ts 里的 id
  /// 升级到真产品表后：指向 Product.id，迁移不改 schema
  productCatalogId String
  productName      String
  productCategory  String
  color            String?
  colorHex         String?
  opacity          Float                  @default(0.85)
  mountingType     String?
  /// Konva Transform 参数：{ offsetX, offsetY, scaleX, scaleY, rotation }
  transformJson    Json?
  notes            String?
  createdAt        DateTime               @default(now())
  region           VisualizerWindowRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  variant          VisualizerVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([regionId])
}

/// 销售推荐 / 客户最终选择
model VisualizerSelection {
  id             String            @id @default(cuid())
  variantId      String
  selectedBy     String
  selectedById   String?
  note           String?
  createdAt      DateTime          @default(now())
  selectedByUser User?             @relation("VisualizerSelectionBy", fields: [selectedById], references: [id])
  variant        VisualizerVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
}

/// 可视化产品库（替代写死的 mock-products）
/// 兼容性：原 mock_xxx id 通过 seed 持久化进 DB，旧 VisualizerProductOption.productCatalogId 不需要改写。
/// 范围：
/// - orgId = null：青砚平台预置（所有组织可见，不可编辑/删除）
/// - orgId = 某组织：组织私有产品（仅组织成员可见、可编辑/软删）
model VisualizerCatalogProduct {
  id                 String                         @id @default(cuid())
  /// null 表示平台预置；非空表示该组织私有
  orgId              String?
  name               String
  category           String
  categoryLabel      String
  previewImageUrl    String?
  textureUrl         String?
  defaultOpacity     Float                          @default(0.85)
  /// [{ name, hex }, ...]
  colorsJson         Json
  /// ["inside","outside"]
  mountingsJson      Json
  /// 可选：弱关联到 pricing-data 中的 ProductName，未来 Visualizer→Quote 一键带价
  pricingProductName String?
  notes              String?
  archived           Boolean                        @default(false)
  createdById        String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  assets             VisualizerCatalogAsset[]
  createdBy          User?                          @relation("VisualizerCatalogCreatedBy", fields: [createdById], references: [id])
  templateJobs       VisualizerCatalogTemplateJob[]

  @@index([orgId, archived])
  @@index([category])
}

/// 产品参考资产。按用途分类，供目录展示和 AI 生成共同使用。
model VisualizerCatalogAsset {
  id                 String                   @id @default(cuid())
  productId          String
  /// installed / texture / detail / style_reference / swatch
  role               String
  fileUrl            String
  fileName           String
  mimeType           String
  width              Int?
  height             Int?
  bytes              Int?
  sortOrder          Int                      @default(0)
  isPrimary          Boolean                  @default(false)
  /// real / ai_generated
  sourceType         String                   @default("real")
  createdById        String?
  createdAt          DateTime                 @default(now())
  /// draft / ai_reference / real_unverified / real_verified
  verificationStatus String                   @default("draft")
  product            VisualizerCatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, role, sortOrder])
  @@index([productId, verificationStatus])
}

/// AI 标准安装模板生成任务（同步执行亦写生命周期，便于后续异步化）
model VisualizerCatalogTemplateJob {
  id             String                   @id @default(cuid())
  productId      String
  /// standard_floor_to_ceiling_day / modern_living_room_day
  templateType   String
  /// queued / running / succeeded / failed
  status         String
  requestedModel String?
  resolvedModel  String?
  promptVersion  String?
  outputAssetId  String?
  errorCode      String?
  errorMessage   String?
  createdById    String
  createdAt      DateTime                 @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  product        VisualizerCatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([productId, templateType, createdAt], map: "VisualizerCatalogTemplateJob_productId_templateType_createdAt_i")
}

/// 矩阵账号登记表
/// 英文社媒（IG/FB/TikTok，Postiz 官方 API 发布）+ 小红书（PostFlow 浏览器自动化发布）
/// 品牌记忆中枢 — 每组织一份品牌语料，供所有内容生产链路统一引用。
/// 严格按 orgId 隔离：无平台级预设、无跨组织回退。
model BrandProfile {
  id              String   @id @default(cuid())
  orgId           String   @unique
  brandName       String
  /// 一句话定位 / slogan
  tagline         String?
  /// 品牌定位与故事（谁、为谁、凭什么）
  positioning     String?
  /// 核心卖点（一行一条）
  sellingPoints   String?
  /// 目标客群画像
  targetAudience  String?
  /// 品牌语气与声音（如：家的温暖、专业不生硬）
  toneOfVoice     String?
  /// 服务范围（城市/配送/安装覆盖）
  serviceScope    String?
  /// 代表案例 / 社会证明（一行一条）
  caseStudies     String?
  /// 内容禁忌（禁用表述、不可承诺项，一行一条）
  forbiddenClaims String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// 内容日历 — 选题规划层：AI 按品牌记忆出选题 → 人工审 → 关联视频资产扇出
model ContentPlanItem {
  id                  String   @id @default(cuid())
  orgId               String
  /// 计划发布日（按天规划，具体时刻在扇出时定）
  plannedDate         DateTime @db.Date
  /// 目标账号组（对应 MatrixAccount.groupName）
  groupName           String
  /// 选题标题
  topic               String
  /// 切入角度 / 内容要点
  angle               String?
  /// 母版文案草稿（扇出时作为 captionText，AI 再做每账号变体）
  suggestedCaption    String?
  hashtags            String?
  /// proposed（AI 生成待审）/ approved（已通过待配视频）/ dispatched（已扇出）/ skipped
  status              String   @default("proposed")
  /// ai / manual / intelligence（来自市场情报确认）
  source              String   @default("ai")
  /// 扇出时关联的视频资产
  assetId             String?
  createdByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  /// 溯源：市场情报信号（intelligence 来源时有值；应用层按 orgId+sourceSignalId 去重）
  sourceSignalId      String?
  /// 溯源：市场研究报告（预留，M1 可空）
  sourceResearchRunId String?

  @@index([orgId, plannedDate])
  @@index([orgId, status])
  @@index([orgId, sourceSignalId])
}

model MatrixAccount {
  id                String       @id @default(cuid())
  orgId             String
  platform          String
  handle            String
  displayName       String?
  /// 账号组：同组共享 persona 模板与内容支柱（如「多伦多华人家居」「EN 智能家居」）
  groupName         String       @default("默认组")
  /// 组内差异化说明（昵称口吻、细分定位等）
  personaNotes      String?
  /// 发布通道：postiz（官方 API）/ postflow（浏览器自动化，DB 队列由服务器 worker 消费）/ manual
  publishChannel    String       @default("manual")
  /// 通道侧账号标识：Postiz integration id 或 PostFlow --account 名
  externalChannelId String?
  status            String       @default("active")
  /// 每日发布配额（防超频限流）
  dailyQuota        Int          @default(3)
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  /// 账号档位：matrix（矩阵号，全自动+抽检）/ premium（精品号，发布 100% 人工审核）
  tier              String       @default("matrix")
  publishJobs       PublishJob[]

  @@unique([orgId, platform, handle])
  @@index([orgId, status])
  @@index([orgId, groupName])
}

/// 视频资产 — 只存元数据与外部 URL，视频文件不经过青砚存储（成本与 serverless 限制）
model VideoAsset {
  id           String       @id @default(cuid())
  orgId        String
  source       String
  externalId   String?
  title        String
  topic        String?
  language     String       @default("en")
  videoUrl     String
  coverUrl     String?
  durationSec  Int?
  /// pending（待配文案）/ ready（可排期）/ scheduled / published / blocked（规则拦截或抽检不过）
  status       String       @default("pending")
  blockReason  String?
  metadataJson Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  publishJobs  PublishJob[]

  @@unique([source, externalId])
  @@index([orgId, status, createdAt])
}

/// 发布任务 — 一条视频 × 一个矩阵账号；文案变体随任务，不随资产（矩阵查重要求每号不同文案）
model PublishJob {
  id               String        @id @default(cuid())
  orgId            String
  assetId          String
  accountId        String
  /// 本账号的差异化文案（变体引擎产出）
  captionText      String
  hashtags         String?
  channel          String
  scheduledAt      DateTime?
  /// draft / review（抽检或高敏滞留）/ blocked（规则拦截）/ queued（已派发到通道）/
  /// processing（postflow worker 已认领）/ published / failed / canceled
  status           String        @default("draft")
  externalJobId    String?
  errorMessage     String?
  /// 抽检标记：true 表示进入人工抽检队列
  sampledForReview Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  attemptCount     Int           @default(0)
  nextAttemptAt    DateTime?
  leaseToken       String?
  leaseExpiresAt   DateTime?
  account          MatrixAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset            VideoAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, accountId])
  @@unique([channel, externalJobId])
  @@index([orgId, status, scheduledAt])
  @@index([accountId, status])
  @@index([channel, status, nextAttemptAt])
  @@index([channel, leaseExpiresAt])
}

/// 自动流统一运行账本。业务数据仍归各自模型所有，此表只记录执行健康度。
model AutomationRun {
  id             String    @id @default(cuid())
  automationKey  String
  orgId          String?
  trigger        String    @default("cron")
  status         String    @default("running")
  processedCount Int       @default(0)
  succeededCount Int       @default(0)
  failedCount    Int       @default(0)
  error          String?   @db.VarChar(2000)
  metadataJson   Json?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  durationMs     Int?
  createdAt      DateTime  @default(now())

  @@index([automationKey, startedAt])
  @@index([orgId, automationKey, startedAt])
  @@index([status, startedAt])
}

/// 企业事实中心。与 BrandProfile（品牌语料）分离，作为检测地域/行业/竞品的事实边界。
model MarketingBrandProfile {
  id                          String    @id @default(cuid())
  orgId                       String    @unique
  legalName                   String
  brandName                   String
  website                     String?
  phone                       String?
  addressLine                 String?
  city                        String?
  region                      String?
  country                     String?
  postalCode                  String?
  timezone                    String    @default("America/Toronto")
  industry                    String
  productsJson                Json      @default("[]")
  serviceAreasJson            Json      @default("[]")
  targetAudiencesJson         Json      @default("[]")
  competitorsJson             Json      @default("[]")
  forbiddenContextsJson       Json      @default("[]")
  canonicalNapJson            Json?
  validationStatus            String    @default("draft")
  validationScore             Int       @default(0)
  validationIssues            Json      @default("[]")
  validatedAt                 DateTime?
  validatedById               String?
  updatedById                 String
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  /// 已确认的产品营销上下文（Product Marketing Context）；AI 只能提议更新，不可直接覆盖
  productMarketingContextJson Json?

  @@index([orgId, validationStatus])
}

/// 渠道账号适配层。Phase 1 可手工录入，providerConfig 为后续 OAuth/API 预留。
model MarketingChannelAccount {
  id                String    @id @default(cuid())
  orgId             String
  provider          String
  name              String
  externalAccountId String?
  status            String    @default("manual")
  providerConfig    Json?
  lastSyncedAt      DateTime?
  lastError         String?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([orgId, provider, name])
  @@index([orgId, status])
}

model MarketingAuditRun {
  id                        String                    @id @default(cuid())
  orgId                     String
  source                    String                    @default("manual")
  status                    String                    @default("draft")
  totalScore                Int?
  confidence                Int                       @default(0)
  profileValidationSnapshot Json
  invalidReason             String?
  startedAt                 DateTime                  @default(now())
  completedAt               DateTime?
  createdById               String
  createdAt                 DateTime                  @default(now())
  scores                    MarketingDimensionScore[]
  findings                  MarketingFinding[]

  @@index([orgId, createdAt])
  @@index([orgId, status])
}

model MarketingDimensionScore {
  id           String            @id @default(cuid())
  orgId        String
  auditRunId   String
  dimension    String
  score        Int
  grade        String
  confidence   Int               @default(100)
  evidenceJson Json?
  createdAt    DateTime          @default(now())
  auditRun     MarketingAuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)

  @@unique([auditRunId, dimension])
  @@index([orgId, dimension])
}

model MarketingFinding {
  id            String             @id @default(cuid())
  orgId         String
  auditRunId    String?
  dimension     String
  severity      String
  title         String
  description   String?
  currentValue  String?
  expectedValue String?
  evidenceUrl   String?
  evidenceJson  Json?
  confidence    Int                @default(100)
  status        String             @default("open")
  taskId        String?
  createdById   String
  resolvedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  auditRun      MarketingAuditRun? @relation(fields: [auditRunId], references: [id])

  @@index([orgId, status, severity])
  @@index([orgId, dimension])
  @@index([taskId])
}

model MarketingPlan {
  id                  String              @id @default(cuid())
  orgId               String
  name                String
  objective           String
  startDate           DateTime            @db.Date
  endDate             DateTime            @db.Date
  status              String              @default("draft")
  createdById         String
  approvedById        String?
  approvedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  projectId           String?
  sourceResearchRunId String?             @unique
  pendingActionId     String?
  items               MarketingPlanItem[]

  @@index([orgId, status, startDate])
}

model MarketingPlanItem {
  id              String        @id @default(cuid())
  orgId           String
  planId          String
  dayOffset       Int
  category        String
  title           String
  description     String?
  priority        String        @default("medium")
  status          String        @default("planned")
  taskId          String?
  findingId       String?
  dueDate         DateTime      @db.Date
  createdAt       DateTime      @default(now())
  ownerId         String?
  successMetric   String?
  targetValue     String?
  stopCondition   String?
  evidenceSummary String?
  confidence      Int?
  plan            MarketingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([orgId, dueDate])
  @@index([planId, dayOffset])
}

model MarketingCampaign {
  id                String                     @id @default(cuid())
  orgId             String
  name              String
  objective         String
  product           String?
  geography         String?
  offer             String?
  primaryConversion String
  status            String                     @default("draft")
  budget            Float?
  currency          String                     @default("CAD")
  startsAt          DateTime?
  endsAt            DateTime?
  createdById       String
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  assets            MarketingContentAsset[]
  experiments       MarketingExperiment[]
  attributions      MarketingLeadAttribution[]
  publications      MarketingPublication[]

  @@index([orgId, status, createdAt])
}

/// 对现有 ContentPlanItem / VideoAsset 的非破坏性关联层。
model MarketingContentAsset {
  id                String            @id @default(cuid())
  orgId             String
