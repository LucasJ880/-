  outputCurrency            String?
  factoryCostCurrency       String?
  exchangeRate              Decimal?                  @db.Decimal(18, 8)
  exchangeRateBaseCurrency  String?
  exchangeRateQuoteCurrency String?
  marginMethod              String?
  targetRate                Decimal?                  @db.Decimal(18, 8)
  totalCost                 Decimal?                  @db.Decimal(18, 6)
  unitSellingPrice          Decimal?                  @db.Decimal(18, 6)
