+++ b/src/lib/tender-rfq/round-pure.ts
@@ -0,0 +1,175 @@
+/**
+ * Tender RFQ — 轮次决策（纯函数，零 DB）
+ */
+
+import { createHash } from "node:crypto";
+import type { RfqFactInput } from "./build";
+import { TENDER_RFQ_DEFAULTS, type ResolvedTenderRfqSettings, type TenderSendRfqPayload } from "./types";
+
+const DAY = 86_400_000;
+
+/* ---------------------------------- 组织设置 ---------------------------------- */
+
+export function readTenderRfqSettings(settingsJson: unknown, env: NodeJS.ProcessEnv = process.env): ResolvedTenderRfqSettings {
+  const raw =
+    settingsJson && typeof settingsJson === "object"
+      ? ((settingsJson as Record<string, unknown>).tenderRfq as Record<string, unknown> | undefined)
+      : undefined;
+  const str = (k: string, envKey: string, d: string) => {
+    const v = raw?.[k];
+    if (typeof v === "string" && v.trim()) return v.trim();
+    const e = env[envKey]?.trim();
+    return e || d;
+  };
+  const num = (k: string, d: number) => {
+    const v = raw?.[k];
+    return typeof v === "number" && Number.isFinite(v) && v >= 0 ? v : d;
+  };
+  return {
+    fromName: str("fromName", "TENDER_RFQ_FROM_NAME", TENDER_RFQ_DEFAULTS.fromName),
+    fromEmail: str("fromEmail", "TENDER_RFQ_FROM_EMAIL", TENDER_RFQ_DEFAULTS.fromEmail).toLowerCase(),
+    replyLeadDays: num("replyLeadDays", TENDER_RFQ_DEFAULTS.replyLeadDays),
+    roundLockDays: num("roundLockDays", TENDER_RFQ_DEFAULTS.roundLockDays),
+  };
+}
+
+/* ---------------------------------- 轮次锁 ---------------------------------- */
+
+export type ExistingRound = {
+  inquiryId: string;
+  roundNumber: number;
+  status: string;
+  createdAt: Date;
+  createdByName: string | null;
+  /** 该轮已发出的 item 数 */
+  sentCount: number;
+  /** 该轮是否已有待批的 tender.send_rfq */
+  hasPendingSend: boolean;
+};
+
+export type RoundLockVerdict =
+  | { locked: false }
+  | { locked: true; reason: "pending_approval" | "recently_sent"; message: string; inquiryId: string };
+
+/**
+ * 同一项目：
+ *   - 已有待批的发送草稿 → 锁（告知谁、何时建的）
+ *   - 最近 roundLockDays 天内有已发出的轮次且未结束 → 锁（告知谁、何时发的）
+ */
+export function decideRoundLock(rounds: ExistingRound[], now: Date, roundLockDays: number): RoundLockVerdict {
+  const pending = rounds.find((r) => r.hasPendingSend);
+  if (pending) {
+    return {
+      locked: true,
+      reason: "pending_approval",
+      inquiryId: pending.inquiryId,
+      message: `第 ${pending.roundNumber} 轮询价已有一张待批的发送草稿（${pending.createdByName ?? "同事"} 于 ${fmt(pending.createdAt)} 创建），先批或驳回它，不要再建一轮。`,
+    };
+  }
+  const recent = rounds
+    .filter((r) => r.sentCount > 0 && r.status !== "completed" && r.status !== "canceled")
+    .filter((r) => now.getTime() - r.createdAt.getTime() < roundLockDays * DAY)
+    .sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime())[0];
+  if (recent) {
+    return {
+      locked: true,
+      reason: "recently_sent",
+      inquiryId: recent.inquiryId,
+      message: `第 ${recent.roundNumber} 轮询价 ${recent.createdByName ?? "同事"} 已于 ${fmt(recent.createdAt)} 发给 ${recent.sentCount} 家，${roundLockDays} 天内不重复发。要补发给新供应商，请在青砚里往这一轮加人。`,
+    };
+  }
+  return { locked: false };
+}
+
+function fmt(d: Date): string {
+  return d.toISOString().slice(0, 16).replace("T", " ");
+}
+
+/* ---------------------------------- 供应商就绪 ---------------------------------- */
+
+export type SupplierCandidate = { id: string; name: string; contactEmail: string | null; status: string };
+
+export function partitionSuppliers(suppliers: SupplierCandidate[]): {
+  ready: Array<SupplierCandidate & { contactEmail: string }>;
+  blocked: Array<{ id: string; name: string; reason: "no_email" | "inactive" }>;
+} {
+  const ready: Array<SupplierCandidate & { contactEmail: string }> = [];
+  const blocked: Array<{ id: string; name: string; reason: "no_email" | "inactive" }> = [];
+  for (const s of suppliers) {
+    if (s.status !== "active") blocked.push({ id: s.id, name: s.name, reason: "inactive" });
+    else if (!s.contactEmail || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s.contactEmail)) blocked.push({ id: s.id, name: s.name, reason: "no_email" });
+    else ready.push({ ...s, contactEmail: s.contactEmail.trim() });
+  }
+  return { ready, blocked };
+}
+
+/* ---------------------------------- 发件账号 ---------------------------------- */
+
+export type SenderProvider = { userId: string; accountEmail: string; grantedScopes: string | null };
+
+export type SenderVerdict =
+  | { ok: true; userId: string }
+  | { ok: false; errorCode: "SENDER_NOT_CONNECTED" | "SENDER_NO_COMPOSE_SCOPE"; message: string };
+
+/** 执行时只允许从配置的发件邮箱发出；谁审批不影响发件人。 */
+export function resolveSender(
+  providers: SenderProvider[],
+  fromEmail: string,
+  hasComposeScope: (scopes: string | null) => boolean,
+): SenderVerdict {
+  const p = providers.find((x) => x.accountEmail.toLowerCase() === fromEmail.toLowerCase());
+  if (!p) {
+    return {
+      ok: false,
+      errorCode: "SENDER_NOT_CONNECTED",
+      message: `发件邮箱 ${fromEmail} 还没有连到任何青砚账号。请用拥有该邮箱的人登录青砚 → 设置 → 连接 Gmail，再审批发送。`,
+    };
+  }
+  if (!hasComposeScope(p.grantedScopes)) {
+    return {
+      ok: false,
+      errorCode: "SENDER_NO_COMPOSE_SCOPE",
+      message: `${fromEmail} 的 Gmail 授权缺少 compose 权限，请重新授权后再审批发送。`,
+    };
+  }
+  return { ok: true, userId: p.userId };
+}
+
+/* ---------------------------------- 关键事实读取 ---------------------------------- */
+
+/**
+ * summaryJson.criticalFacts[type] 兼容三种形状：{status:"KNOWN", factId} / {status:"KNOWN", text} / 字符串。
+ * 返回 factId（优先，调用方再查 TenderAnalysisFact 取置信与原文）或直接文本。
+ */
+export function readCriticalFactSlot(summaryJson: unknown, type: string): { factId: string } | { text: string } | null {
+  const cf = (summaryJson as Record<string, unknown> | null)?.criticalFacts as Record<string, unknown> | undefined;
+  const slot = cf?.[type];
+  if (typeof slot === "string") return slot.trim() ? { text: slot.trim() } : null;
+  if (slot && typeof slot === "object") {
+    const o = slot as { status?: unknown; factId?: unknown; text?: unknown; value?: unknown };
+    if (o.status !== undefined && o.status !== "KNOWN") return null;
+    if (typeof o.factId === "string" && o.factId) return { factId: o.factId };
+    const t = typeof o.text === "string" ? o.text : typeof o.value === "string" ? o.value : "";
+    return t.trim() && t.trim().toUpperCase() !== "N/A" ? { text: t.trim() } : null;
+  }
+  return null;
+}
+
+/** 把 slot 文本包装成 RfqFactInput（文本形状视为已确认——它来自人工审阅过的汇总）。 */
+export function factFromText(type: string, text: string): RfqFactInput {
+  return { type, contentZh: text, contentOriginal: null, confidence: "HIGH", manuallyConfirmed: true };
+}
+
+/* ---------------------------------- Payload ---------------------------------- */
+
+export function hashRfqPayloadItems(items: TenderSendRfqPayload["items"]): string {
+  const h = createHash("sha256");
+  for (const i of items) h.update(`${i.inquiryItemId}|${i.to}|${i.subject}|${i.body}\n`);
+  return h.digest("hex").slice(0, 16);
+}
+
+/** 审批卡预览：每家一行，不贴正文（正文在青砚里看）。 */
+export function previewRfqPayload(p: TenderSendRfqPayload): string {
+  const lines = p.items.map((i) => `· ${i.supplierName} <${i.to}>`);
+  return `第 ${p.roundNumber} 轮询价，${p.items.length} 封邮件，发件人 "${p.fromName}" <${p.fromEmail}>：\n${lines.join("\n")}\n主题：${p.items[0]?.subject ?? ""}`;
+}
diff --git a/src/lib/tender-rfq/service.ts b/src/lib/tender-rfq/service.ts
new file mode 100644
index 0000000..465ea93
--- /dev/null
+++ b/src/lib/tender-rfq/service.ts
@@ -0,0 +1,245 @@
+/**
+ * Tender RFQ（P1-2）— 准备一轮询价 → PendingAction（tender.send_rfq）
+ *
+ * 流程：项目/组织 → 轮次锁 → 供应商就绪 → 已确认要求 + 关键事实 → buildRfqDocument
+ *       → 创建 ProjectInquiry(draft) + items → 每家渲染邮件 → createDraft（审批卡）
+ *
+ * 本函数零出站。真正发送只在 execute.ts（批准后）。
+ */
+
+import { db } from "@/lib/db";
+import { createDraft } from "@/lib/pending-actions/drafts";
+import { addInquiryItem, createInquiry } from "@/lib/inquiry/service";
+import { buildRfqDocument, renderRfqEmail, type RfqFactInput, type RfqRequirementInput } from "./build";
+import {
+  decideRoundLock,
+  factFromText,
+  hashRfqPayloadItems,
+  partitionSuppliers,
+  previewRfqPayload,
+  readCriticalFactSlot,
+  readTenderRfqSettings,
+  type ExistingRound,
+} from "./round-pure";
+import { TENDER_SEND_RFQ_TYPE, type TenderSendRfqPayload } from "./types";
+
+const RFQ_FACT_TYPES = ["quantity", "delivery", "location", "warranty", "scope"] as const;
+
+export type PrepareRfqInput = {
+  projectId: string;
+  orgId: string;
+  userId: string;
+  supplierIds?: string[];
+  /** 没给 supplierIds 时按名称模糊匹配 */
+  supplierHint?: string | null;
+  scopeNote?: string | null;
+  extraQuestions?: string[];
+  incoterm?: "EXW" | "FOB" | "CIF" | "DDP" | "DAP" | null;
+  destination?: string | null;
+  quantityTiers?: number[];
+  now?: Date;
+};
+
+export type PrepareRfqResult =
+  | {
+      ok: true;
+      actionId: string;
+      inquiryId: string;
+      roundNumber: number;
+      preview: string;
+      replyBy: string | null;
+      fromEmail: string;
+      suppliers: Array<{ id: string; name: string; to: string }>;
+      blockedSuppliers: Array<{ id: string; name: string; reason: "no_email" | "inactive" }>;
+      excludedRequirements: number;
+    }
+  | {
+      ok: false;
+      errorCode:
+        | "PROJECT_NOT_FOUND"
+        | "ROUND_LOCKED"
+        | "NO_SUPPLIERS"
+        | "SUPPLIERS_NOT_READY"
+        | "NO_CONFIRMED_REQUIREMENTS"
+        | "SENSITIVE_LEAK"
+        | "DRAFT_FAILED";
+      message: string;
+      /** NO_SUPPLIERS 时给候选，让 Muse 渲染成可选项 */
+      candidates?: Array<{ id: string; name: string; contactEmail: string | null }>;
+      blockedSuppliers?: Array<{ id: string; name: string; reason: "no_email" | "inactive" }>;
+    };
+
+export async function prepareRfqRound(input: PrepareRfqInput): Promise<PrepareRfqResult> {
+  const now = input.now ?? new Date();
+
+  const project = await db.project.findFirst({
+    where: { id: input.projectId, orgId: input.orgId, workDomain: "tender" },
+    select: { id: true, name: true, closeDate: true, org: { select: { settingsJson: true } } },
+  });
+  if (!project) return { ok: false, errorCode: "PROJECT_NOT_FOUND", message: "没找到这个投标项目，或它不属于你的组织。" };
+  const settings = readTenderRfqSettings(project.org?.settingsJson);
+
+  // ── 轮次锁 ──
+  const rounds = await db.projectInquiry.findMany({
+    where: { projectId: project.id },
+    select: {
+      id: true,
+      roundNumber: true,
+      status: true,
+      createdAt: true,
+      createdById: true,
+      items: { select: { status: true } },
+    },
+  });
+  const pendingSends = await db.pendingAction.findMany({
+    where: { orgId: input.orgId, projectId: project.id, type: TENDER_SEND_RFQ_TYPE, status: { in: ["pending", "approved"] } },
+    select: { payload: true },
+  });
+  const pendingInquiryIds = new Set(pendingSends.map((p) => (p.payload as { inquiryId?: string } | null)?.inquiryId).filter(Boolean));
+  const creatorIds = [...new Set(rounds.map((r) => r.createdById))];
+  const creators = creatorIds.length ? await db.user.findMany({ where: { id: { in: creatorIds } }, select: { id: true, name: true } }) : [];
+  const nameOf = new Map(creators.map((u) => [u.id, u.name]));
+  const existing: ExistingRound[] = rounds.map((r) => ({
+    inquiryId: r.id,
+    roundNumber: r.roundNumber,
+    status: r.status,
+    createdAt: r.createdAt,
+    createdByName: nameOf.get(r.createdById) ?? null,
+    sentCount: r.items.filter((i) => i.status !== "pending").length,
+    hasPendingSend: pendingInquiryIds.has(r.id),
+  }));
+  const lock = decideRoundLock(existing, now, settings.roundLockDays);
+  if (lock.locked) return { ok: false, errorCode: "ROUND_LOCKED", message: lock.message };
+
+  // ── 供应商 ──
+  const where = input.supplierIds?.length
+    ? { orgId: input.orgId, id: { in: input.supplierIds } }
+    : input.supplierHint?.trim()
+      ? { orgId: input.orgId, name: { contains: input.supplierHint.trim(), mode: "insensitive" as const } }
+      : null;
+  if (!where) {
+    const candidates = await db.supplier.findMany({
+      where: { orgId: input.orgId, status: "active" },
+      orderBy: { updatedAt: "desc" },
+      take: 8,
+      select: { id: true, name: true, contactEmail: true },
+    });
+    return { ok: false, errorCode: "NO_SUPPLIERS", message: "要问哪几家？", candidates };
+  }
+  const suppliers = await db.supplier.findMany({ where, select: { id: true, name: true, contactEmail: true, status: true } });
+  const { ready, blocked } = partitionSuppliers(suppliers);
+  if (ready.length === 0) {
+    return {
+      ok: false,
+      errorCode: "SUPPLIERS_NOT_READY",
+      message: blocked.length
+        ? `这些供应商还发不了：${blocked.map((b) => `${b.name}（${b.reason === "no_email" ? "没有邮箱" : "已停用"}）`).join("、")}。先在青砚补上联系邮箱。`
+        : "没匹配到供应商。",
+      blockedSuppliers: blocked,
+    };
+  }
+
+  // ── 要求 + 事实（最新非 SUPERSEDED 的 run） ──
+  const run = await db.tenderAnalysisRun.findFirst({
+    where: { projectId: project.id, status: { in: ["REVIEW_REQUIRED", "APPROVED"] } },
+    orderBy: { createdAt: "desc" },
+    select: {
+      id: true,
+      summaryJson: true,
+      requirements: {
+        select: { requirementCode: true, category: true, originalRequirement: true, chineseTranslation: true, mandatory: true, reviewStatus: true, sourcePage: true },
+        orderBy: { requirementCode: "asc" },
+      },
+    },
+  });
+  const requirements: RfqRequirementInput[] = run?.requirements ?? [];
+
+  const facts: RfqFactInput[] = [];
+  if (run) {
+    const factIds: Array<{ type: string; factId: string }> = [];
+    for (const t of RFQ_FACT_TYPES) {
+      const slot = readCriticalFactSlot(run.summaryJson, t);
+      if (!slot) continue;
+      if ("text" in slot) facts.push(factFromText(t, slot.text));
+      else factIds.push({ type: t, factId: slot.factId });
+    }
+    if (factIds.length) {
+      const rows = await db.tenderAnalysisFact.findMany({
+        where: { id: { in: factIds.map((f) => f.factId) } },
+        select: { id: true, contentZh: true, contentOriginal: true, confidence: true, manuallyConfirmed: true },
+      });
+      for (const f of factIds) {
+        const r = rows.find((x) => x.id === f.factId);
+        if (r) facts.push({ type: f.type, contentZh: r.contentZh, contentOriginal: r.contentOriginal, confidence: r.confidence, manuallyConfirmed: r.manuallyConfirmed });
+      }
+    }
+  }
+
+  const built = buildRfqDocument({
+    projectName: project.name,
+    buyerDisplayName: settings.fromName,
+    closeDate: project.closeDate ? project.closeDate.toISOString() : null,
+    now,
+    requirements,
+    facts,
+    quantityTiers: input.quantityTiers,
+    incoterm: input.incoterm ?? null,
+    destination: input.destination ?? null,
+    replyLeadDays: settings.replyLeadDays,
+    extraQuestions: input.extraQuestions,
+    scopeNote: input.scopeNote ?? null,
+  });
+  if (!built.ok) return { ok: false, errorCode: built.errorCode, message: built.message };
+  const doc = built.doc;
+
+  // ── 建轮次（draft，零出站） ──
+  const inquiry = await createInquiry(
+    { projectId: project.id, title: `第 N 轮询价（Muse）`, scope: doc.scopeNote ?? undefined, dueDate: doc.replyBy ?? undefined },
+    input.userId,
+  );
+  const items: TenderSendRfqPayload["items"] = [];
+  for (const s of ready) {
+    const item = await addInquiryItem({ projectId: project.id, inquiryId: inquiry.id }, s.id, input.userId);
+    const mail = renderRfqEmail(doc, { supplierName: s.name, roundNumber: inquiry.roundNumber });
+    items.push({ inquiryItemId: item.id, supplierId: s.id, supplierName: s.name, to: s.contactEmail, subject: mail.subject, body: mail.body });
+  }
+
+  const payload: TenderSendRfqPayload = {
+    projectId: project.id,
+    inquiryId: inquiry.id,
+    roundNumber: inquiry.roundNumber,
+    fromName: settings.fromName,
+    fromEmail: settings.fromEmail,
+    items,
+    rfqDocHash: hashRfqPayloadItems(items),
+  };
+
+  const draft = await createDraft({
+    type: TENDER_SEND_RFQ_TYPE,
+    title: `发送第 ${inquiry.roundNumber} 轮询价给 ${items.length} 家供应商 — ${project.name}`,
+    preview: previewRfqPayload(payload),
+    payload: payload as unknown as Record<string, unknown>,
+    userId: input.userId,
+    orgId: input.orgId,
+    projectId: project.id,
+    ttlHours: 72,
+    idempotencyKey: `${TENDER_SEND_RFQ_TYPE}:${inquiry.id}`,
+  });
+  if (!draft.success) {
+    return { ok: false, errorCode: "DRAFT_FAILED", message: `生成审批草稿失败：${draft.error}` };
+  }
+  const actionId = (draft.data as { actionId?: string } | null)?.actionId ?? "";
+
+  return {
+    ok: true,
+    actionId,
+    inquiryId: inquiry.id,
+    roundNumber: inquiry.roundNumber,
+    preview: payload.items.map((i) => `${i.supplierName} <${i.to}>`).join("、"),
+    replyBy: doc.replyBy,
+    fromEmail: settings.fromEmail,
+    suppliers: items.map((i) => ({ id: i.supplierId, name: i.supplierName, to: i.to })),
+    blockedSuppliers: blocked,
+    excludedRequirements: doc.excluded.length,
+  };
+}
