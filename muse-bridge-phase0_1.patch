+/**
+ * Muse Bridge — 事件信封构造（纯函数，零 DB），供 events.ts 与测试共用。
+ */
+
+import { MUSE_BRIDGE_CONTRACT_VERSION, museEventEnvelopeSchema, type MuseEventEnvelope } from "./contract";
+import { sanitizeOutbound } from "./router-pure";
+
+export type EmitMuseEventInput = Omit<MuseEventEnvelope, "contractVersion" | "occurredAt"> & {
+  occurredAt?: string;
+};
+
+/** 纯函数：构造并校验信封（测试用；不落库）。 */
+export function buildMuseEvent(input: EmitMuseEventInput): MuseEventEnvelope | null {
+  const candidate = {
+    ...input,
+    contractVersion: MUSE_BRIDGE_CONTRACT_VERSION,
+    summary: sanitizeOutbound(input.summary).slice(0, 300),
+    occurredAt: input.occurredAt ?? new Date().toISOString(),
+  };
+  const r = museEventEnvelopeSchema.safeParse(candidate);
+  return r.success ? r.data : null;
+}
+
diff --git a/src/lib/muse-bridge/events.ts b/src/lib/muse-bridge/events.ts
new file mode 100644
index 0000000..1fd30bf
--- /dev/null
+++ b/src/lib/muse-bridge/events.ts
@@ -0,0 +1,177 @@
+/**
+ * Muse Bridge — 事件出站（零 schema，复用 Notification 作为 outbox）
+ *
+ * 设计：
+ *   - 每条 Muse 事件 = 一条 Notification（category="muse_bridge"，metadata.museEvent=信封）。
+ *     用户在青砚站内也能看到同一条，Bridge 通过 GET /api/bridge/muse/events 按游标拉取。
+ *   - 幂等：Notification.sourceKey = eventId（同一业务事实绝不推两次）。
+ *   - 失败语义：emit 绝不上抛影响调用方（分析终态化 / 审批创建 / 路由）。
+ *   - 出站脱敏在信封构造时完成（sanitizeOutbound）。
+ */
+
+import { db } from "@/lib/db";
+import { createNotification } from "@/lib/notifications/create";
+import { museEventEnvelopeSchema, type MuseEventEnvelope, type MuseEventType } from "./contract";
+import { isMuseBridgeEnabled } from "./flags";
+import { buildMuseEvent, type EmitMuseEventInput } from "./events-pure";
+
+export const MUSE_EVENT_CATEGORY = "muse_bridge" as const;
+
+/** 事件类型 → 复用的站内通知 type（保持用户通知偏好语义）。 */
+function notificationTypeFor(type: MuseEventType): string {
+  switch (type) {
+    case "approval.requested":
+    case "approval.resolved":
+      return "agent_approval";
+    case "brief.daily":
+      return "sales_daily_briefing";
+    default:
+      return "project_update";
+  }
+}
+
+
+/** 落库（幂等）。返回 { emitted: false } 表示被开关关闭 / 已存在 / 校验失败 / 落库失败。 */
+export async function emitMuseEvent(
+  input: EmitMuseEventInput,
+): Promise<{ emitted: boolean; reason?: string }> {
+  try {
+    if (!isMuseBridgeEnabled()) return { emitted: false, reason: "bridge_disabled" };
+    const envelope = buildMuseEvent(input);
+    if (!envelope) return { emitted: false, reason: "invalid_envelope" };
+    const sourceKey = `muse:${envelope.eventId}`;
+    const existing = await db.notification.findUnique({ where: { sourceKey }, select: { id: true } });
+    if (existing) return { emitted: false, reason: "duplicate" };
+    await createNotification({
+      userId: envelope.userId,
+      orgId: envelope.orgId,
+      projectId: envelope.projectId,
+      type: notificationTypeFor(envelope.type),
+      category: MUSE_EVENT_CATEGORY,
+      title: titleFor(envelope),
+      summary: envelope.summary,
+      entityType: envelope.approval ? envelope.approval.kind : envelope.projectId ? "project" : undefined,
+      entityId: envelope.approval?.approvalId ?? envelope.projectId,
+      priority: envelope.type === "approval.requested" || envelope.type === "deadline.approaching" ? "high" : "medium",
+      sourceKey,
+      metadata: { museEvent: envelope },
+    });
+    return { emitted: true };
+  } catch (err) {
+    console.error("[muse-bridge] emitMuseEvent failed:", err);
+    return { emitted: false, reason: "persist_failed" };
+  }
+}
+
+function titleFor(e: MuseEventEnvelope): string {
+  const name = e.projectName ? `「${e.projectName.slice(0, 40)}」` : "";
+  switch (e.type) {
+    case "approval.requested":
+      return `${name}有一条待你批准`;
+    case "approval.resolved":
+      return `${name}审批已处理`;
+    case "analysis.ready":
+      return `${name}分析完成`;
+    case "reply.received":
+      return `${name}供应商回复了`;
+    case "quote.parsed":
+      return `${name}新报价已入表`;
+    case "missing_fields":
+      return `${name}报价缺字段`;
+    case "addendum.detected":
+      return `${name}招标文件有更新`;
+    case "deadline.approaching":
+      return `${name}截标临近`;
+    case "brief.daily":
+      return "今日投标早报";
+  }
+}
+
+/** Bridge 拉取：按 createdAt 游标，只返回该用户 + 该 org 的 muse 事件。 */
+export async function listMuseEvents(input: {
+  userId: string;
+  orgId: string;
+  sinceIso?: string | null;
+  limit?: number;
+}): Promise<{ events: MuseEventEnvelope[]; nextSince: string | null }> {
+  const since = input.sinceIso ? new Date(input.sinceIso) : null;
+  const take = Math.min(Math.max(input.limit ?? 50, 1), 200);
+  const rows = await db.notification.findMany({
+    where: {
+      userId: input.userId,
+      orgId: input.orgId,
+      category: MUSE_EVENT_CATEGORY,
+      ...(since && !Number.isNaN(since.getTime()) ? { createdAt: { gt: since } } : {}),
+    },
+    orderBy: { createdAt: "asc" },
+    take,
+    select: { metadata: true, createdAt: true },
+  });
+  const events: MuseEventEnvelope[] = [];
+  for (const r of rows) {
+    if (!r.metadata) continue;
+    try {
+      const parsed = museEventEnvelopeSchema.safeParse((JSON.parse(r.metadata) as { museEvent?: unknown }).museEvent);
+      if (parsed.success) events.push(parsed.data);
+    } catch {
+      /* 坏行跳过，不影响其它事件 */
+    }
+  }
+  const nextSince = rows.length ? rows[rows.length - 1].createdAt.toISOString() : input.sinceIso ?? null;
+  return { events, nextSince };
+}
+
+// ── 挂钩点 helper（供 drafts.ts / 分析终态化 / inquiry 状态变更调用，均 best-effort）──
+
+/** PendingAction 创建后：向有权审批的人推审批卡。 */
+export async function emitApprovalRequested(input: {
+  actionId: string;
+  orgId: string | null | undefined;
+  recipientUserId: string;
+  projectId?: string | null;
+  projectName?: string | null;
+  title: string;
+  expiresAt?: Date | null;
+}): Promise<void> {
+  if (!input.orgId) return;
+  await emitMuseEvent({
+    eventId: `approval.requested:${input.actionId}`,
+    type: "approval.requested",
+    orgId: input.orgId,
+    userId: input.recipientUserId,
+    projectId: input.projectId ?? undefined,
+    projectName: input.projectName ?? undefined,
+    summary: `待批：${input.title}。回复"批准"或"驳回"即可。`,
+    approval: {
+      approvalId: input.actionId,
+      kind: "pending_action",
+      expiresAt: input.expiresAt ? input.expiresAt.toISOString() : undefined,
+    },
+    action: { label: "批准", command: { intent: "approve", approvalId: input.actionId } },
+  });
+}
+
+/** 分析终态化后：推一句话结论 + 建议下一步。 */
+export async function emitAnalysisReady(input: {
+  runId: string;
+  orgId: string | null | undefined;
+  recipientUserId: string;
+  projectId: string;
+  projectName: string;
+  summary: string;
+}): Promise<void> {
+  if (!input.orgId) return;
+  await emitMuseEvent({
+    eventId: `analysis.ready:${input.runId}`,
+    type: "analysis.ready",
+    orgId: input.orgId,
+    userId: input.recipientUserId,
+    projectId: input.projectId,
+    projectName: input.projectName,
+    summary: input.summary,
+    action: {
+      label: "问它最需要我做什么",
+      command: { intent: "ask", projectId: input.projectId, question: "这个标现在最需要我做什么？" },
+    },
+  });
+}
diff --git a/src/lib/muse-bridge/flags.ts b/src/lib/muse-bridge/flags.ts
new file mode 100644
index 0000000..ca3b400
--- /dev/null
+++ b/src/lib/muse-bridge/flags.ts
@@ -0,0 +1,38 @@
+/**
+ * Muse Bridge — 开关（生产默认全关）
+ *
+ *   MUSE_BRIDGE_ENABLED   "1" 才开；否则 /api/bridge/muse/* 一律 BRIDGE_DISABLED
+ *   MUSE_BRIDGE_INTENTS   逗号分隔的意图白名单；为空 → 仅 Phase 0 四个意图
+ *                         例：status,ask,approve,reject,rfq
+ *   MUSE_BRIDGE_ORG_ALLOWLIST  逗号分隔 orgId；为空 → 任意 org（仍需绑定 + membership）
+ */
+
+import { MUSE_PHASE0_INTENTS, isMuseIntent, type MuseIntent } from "./contract";
+
+function envOn(v: string | undefined): boolean {
+  const s = (v ?? "").trim().toLowerCase();
+  return s === "1" || s === "true" || s === "on";
+}
+
+function envList(v: string | undefined): string[] {
+  return (v ?? "").split(",").map((x) => x.trim()).filter(Boolean);
+}
+
+export function isMuseBridgeEnabled(env: NodeJS.ProcessEnv = process.env): boolean {
+  return envOn(env.MUSE_BRIDGE_ENABLED);
+}
+
+/** 当前放行的意图集（纯函数，便于测试）。 */
+export function enabledMuseIntents(env: NodeJS.ProcessEnv = process.env): ReadonlySet<MuseIntent> {
+  const configured = envList(env.MUSE_BRIDGE_INTENTS).filter(isMuseIntent);
+  return new Set(configured.length > 0 ? configured : MUSE_PHASE0_INTENTS);
+}
+
+export function isMuseIntentEnabled(intent: MuseIntent, env: NodeJS.ProcessEnv = process.env): boolean {
+  return enabledMuseIntents(env).has(intent);
+}
+
+export function isMuseOrgAllowed(orgId: string, env: NodeJS.ProcessEnv = process.env): boolean {
+  const list = envList(env.MUSE_BRIDGE_ORG_ALLOWLIST);
+  return list.length === 0 || list.includes(orgId);
+}
diff --git a/src/lib/muse-bridge/hooks.ts b/src/lib/muse-bridge/hooks.ts
new file mode 100644
index 0000000..7e95daa
--- /dev/null
+++ b/src/lib/muse-bridge/hooks.ts
@@ -0,0 +1,178 @@
+/**
+ * Muse Bridge — 业务挂钩入口（P0-7 / P0-8）
+ *
+ * 调用方只传 id，本文件负责取上下文并发事件；三条铁律：
+ *   1. 绝不上抛（任何失败只 console.error）；
+ *   2. 开关关闭时在第一行短路，不查库；
+ *   3. 收件人与站内通知保持一致（analysis.ready 复用 alerts.ts 的 resolveFailureRecipients）。
+ *
+ * 挂钩点：
+ *   - analysis.ready  : tender-auto-analysis/worker.ts FINALIZE（legacy）
+ *                       tender-workforce/tools.ts 两个 finalize（workforce）
+ *   - reply.received  : inquiry/service.ts markItemReplied
+ *   - quote.parsed    : inquiry/service.ts recordQuote
+ */
+
+import { db } from "@/lib/db";
+import { resolveFailureRecipients, tenderSuccessSummary } from "@/lib/tender-auto-analysis/alerts";
+import { emitAnalysisReady, emitMuseEvent } from "./events";
+import { isMuseBridgeEnabled } from "./flags";
+
+/** 分析终态化（REVIEW_REQUIRED）→ analysis.ready。幂等键 = runId。 */
+export async function museOnAnalysisFinalized(runId: string): Promise<void> {
+  if (!isMuseBridgeEnabled()) return;
+  try {
+    const run = await db.tenderAnalysisRun.findUnique({
+      where: { id: runId },
+      select: {
+        id: true,
+        orgId: true,
+        projectId: true,
+        status: true,
+        createdById: true,
+        summaryJson: true,
+        project: { select: { name: true, ownerId: true } },
+      },
+    });
+    if (!run || run.status !== "REVIEW_REQUIRED" || !run.orgId) return;
+
+    const recipients = resolveFailureRecipients({ ownerId: run.project?.ownerId, createdById: run.createdById });
+    if (recipients.length === 0) return;
+
+    const sj = (run.summaryJson ?? {}) as Record<string, unknown>;
+    const syn = sj.analystSynthesis as
+      | {
+          coverage?: { analyzed?: number; uploaded?: number };
+          keyRequirements?: unknown[];
+          risksAndGaps?: unknown[];
+          clarifications?: unknown[];
+          qa?: { needsHumanReview?: boolean };
+        }
+      | undefined;
+    const summary = tenderSuccessSummary({
+      projectName: run.project?.name ?? null,
+      analyzedFiles: syn?.coverage?.analyzed ?? null,
+      uploadedFiles: syn?.coverage?.uploaded ?? null,
+      keyRequirements: syn?.keyRequirements?.length ?? null,
+      risks: syn?.risksAndGaps?.length ?? null,
+      clarifications: syn?.clarifications?.length ?? null,
+      needsHumanReview: syn?.qa?.needsHumanReview === true,
+    });
+
+    for (const userId of recipients) {
+      await emitAnalysisReady({
+        runId: `${run.id}:${userId}`,
+        orgId: run.orgId,
+        recipientUserId: userId,
+        projectId: run.projectId,
+        projectName: run.project?.name ?? "投标项目",
+        summary,
+      });
+    }
+  } catch (err) {
+    console.error("[muse-bridge] analysis.ready hook failed:", err);
+  }
+}
+
+type InquiryItemContext = {
+  orgId: string;
+  projectId: string;
+  projectName: string;
+  ownerId: string;
+  supplierName: string;
+  inquiryTitle: string | null;
+  roundNumber: number | null;
+};
+
+async function loadInquiryItemContext(itemId: string): Promise<InquiryItemContext | null> {
+  const item = await db.inquiryItem.findUnique({
+    where: { id: itemId },
+    select: {
+      supplier: { select: { name: true } },
+      inquiry: {
+        select: {
+          title: true,
+          roundNumber: true,
+          project: { select: { id: true, name: true, orgId: true, ownerId: true } },
+        },
+      },
+    },
+  });
+  const p = item?.inquiry?.project;
+  if (!item || !p || !p.orgId) return null;
+  return {
+    orgId: p.orgId,
+    projectId: p.id,
+    projectName: p.name,
+    ownerId: p.ownerId,
+    supplierName: item.supplier?.name ?? "供应商",
+    inquiryTitle: item.inquiry.title ?? null,
+    roundNumber: item.inquiry.roundNumber ?? null,
+  };
+}
+
+/** 供应商回复（尚无报价）→ reply.received。 */
+export async function museOnInquiryReplied(itemId: string): Promise<void> {
+  if (!isMuseBridgeEnabled()) return;
+  try {
+    const ctx = await loadInquiryItemContext(itemId);
+    if (!ctx) return;
+    await emitMuseEvent({
+      eventId: `reply.received:${itemId}`,
+      type: "reply.received",
+      orgId: ctx.orgId,
+      userId: ctx.ownerId,
+      projectId: ctx.projectId,
+      projectName: ctx.projectName,
+      summary: `${ctx.supplierName} 回复了${ctx.roundNumber ? `第 ${ctx.roundNumber} 轮` : ""}询价，报价还没录入。`,
+      action: { label: "看这个标的状态", command: { intent: "status", projectId: ctx.projectId } },
+    });
+  } catch (err) {
+    console.error("[muse-bridge] reply.received hook failed:", err);
+  }
+}
+
+/** 报价录入 → quote.parsed（缺字段如实列出，不猜）。幂等键含录入时间戳：同一供应商改价会再推一次。 */
+export async function museOnQuoteRecorded(
+  itemId: string,
+  quote: {
+    unitPrice?: unknown;
+    totalPrice?: unknown;
+    currency?: string | null;
+    deliveryDays?: number | null;
+    validUntil?: Date | string | null;
+  },
+): Promise<void> {
+  if (!isMuseBridgeEnabled()) return;
+  try {
+    const ctx = await loadInquiryItemContext(itemId);
+    if (!ctx) return;
+    const missing: string[] = [];
+    if (quote.unitPrice == null && quote.totalPrice == null) missing.push("价格");
+    if (!quote.currency) missing.push("币种");
+    if (quote.deliveryDays == null) missing.push("交期");
+    if (!quote.validUntil) missing.push("有效期");
+    const price =
+      quote.totalPrice != null
+        ? `总价 ${String(quote.totalPrice)} ${quote.currency ?? ""}`
+        : quote.unitPrice != null
+          ? `单价 ${String(quote.unitPrice)} ${quote.currency ?? ""}`
+          : "价格未填";
+    const lead = quote.deliveryDays != null ? `交期 ${quote.deliveryDays} 天` : "交期未填";
+    const summary =
+      `${ctx.supplierName} 报价已入表：${price}，${lead}。` +
+      (missing.length ? `缺：${missing.join("、")}，建议追问。` : "字段齐全。");
+    await emitMuseEvent({
+      eventId: `quote.parsed:${itemId}:${Date.now()}`,
+      type: missing.length ? "missing_fields" : "quote.parsed",
+      orgId: ctx.orgId,
+      userId: ctx.ownerId,
+      projectId: ctx.projectId,
+      projectName: ctx.projectName,
+      summary,
+      action: { label: "看这个标的状态", command: { intent: "status", projectId: ctx.projectId } },
+    });
+  } catch (err) {
+    console.error("[muse-bridge] quote.parsed hook failed:", err);
+  }
+}
diff --git a/src/lib/muse-bridge/router-pure.ts b/src/lib/muse-bridge/router-pure.ts
new file mode 100644
index 0000000..5b9d19f
--- /dev/null
+++ b/src/lib/muse-bridge/router-pure.ts
@@ -0,0 +1,190 @@
+/**
+ * Muse Bridge — 纯路由逻辑（零 DB / 零 LLM / 零出站）
+ *
+ * 所有"把青砚内部状态翻译成 Muse 能转述的一句话"的逻辑都在这里，便于离线测试。
+ * router.ts 只负责取数和调用现有服务，然后交给本文件格式化。
+ */
+
+import {
+  MUSE_BRIDGE_CONTRACT_VERSION,
+  MUSE_INTENT_PHASE,
+  containsOutboundSensitive,
+  type MuseCommandArgs,
+  type MuseCommandResponse,
+  type MuseErrorCode,
+  type MuseIntent,
+  type MuseSuggestedAction,
+} from "./contract";
+import { getProjectStage, resolveCloseDate } from "@/lib/tender/stage";
+import type { TenderProject } from "@/lib/tender/types";
+
+// ── 响应构造 ────────────────────────────────────────────────────
+
+export function okResponse(
+  requestId: string,
+  message: string,
+  extra?: { data?: unknown; suggestedActions?: MuseSuggestedAction[] },
+): MuseCommandResponse {
+  return {
+    contractVersion: MUSE_BRIDGE_CONTRACT_VERSION,
+    requestId,
+    ok: true,
+    message: sanitizeOutbound(message),
+    data: extra?.data,
+    suggestedActions: (extra?.suggestedActions ?? []).slice(0, 4),
+  };
+}
+
+export function errResponse(
+  requestId: string,
+  errorCode: MuseErrorCode,
+  message: string,
+  extra?: { availableInPhase?: number; suggestedActions?: MuseSuggestedAction[] },
+): MuseCommandResponse {
+  return {
+    contractVersion: MUSE_BRIDGE_CONTRACT_VERSION,
+    requestId,
+    ok: false,
+    message: sanitizeOutbound(message),
+    suggestedActions: (extra?.suggestedActions ?? []).slice(0, 4),
+    errorCode,
+    availableInPhase: extra?.availableInPhase,
+  };
+}
+
+/** 出站脱敏：命中敏感字段 → 整段替换，而不是尝试"抠掉一部分"。 */
+export function sanitizeOutbound(text: string): string {
+  const t = text.length > 1200 ? `${text.slice(0, 1199)}…` : text;
+  return containsOutboundSensitive(t) ? "（该内容包含内部财务信息，不通过 Muse 通道输出，请在青砚内查看。）" : t;
+}
+
+/** 未启用意图的统一回复（诚实告知阶段）。 */
+export function notEnabledResponse(requestId: string, intent: MuseIntent): MuseCommandResponse {
+  const phase = MUSE_INTENT_PHASE[intent];
+  const label: Record<MuseIntent, string> = {
+    status: "查看状态",
+    ask: "基于证据问答",
+    approve: "批准",
+    reject: "驳回",
+    follow_tender: "跟进新标（标讯雷达）",
+    rfq: "生成并发送询价",
+    chase: "催单",
+    compare: "比价",
+    price_scenario: "定价情景",
+  };
+  return errResponse(
+    requestId,
+    "INTENT_NOT_ENABLED",
+    `「${label[intent]}」这个动作当前还没在 Muse 通道开放（属于 Phase ${phase}），请先在青砚里操作。`,
+    { availableInPhase: phase },
+  );
+}
+
+// ── status ──────────────────────────────────────────────────────
+
+export type StatusProjectRow = TenderProject & {
+  id: string;
+  name: string;
+  /** 最新分析状态（TenderAnalysisRun.status），无则 null */
+  analysisStatus: string | null;
+  /** 待办审批数（该用户可见） */
+  pendingApprovals: number;
+};
+
+const STAGE_LABEL: Record<string, string> = {
+  initiation: "立项",
+  distribution: "分发",
+  interpretation: "解读",
+  supplier_inquiry: "询价",
+  supplier_quote: "报价",
+  submission: "提交",
+};
+
+const ANALYSIS_LABEL: Record<string, string> = {
+  PENDING: "排队中",
+  EXTRACTING: "解析中",
+  ANALYZING: "分析中",
+  REVIEW_REQUIRED: "待人工审阅",
+  APPROVED: "分析已确认",
+  FAILED: "分析失败",
+  SUPERSEDED: "已被新版本覆盖",
+};
+
+function daysUntil(d: Date | null, now: Date): number | null {
+  if (!d) return null;
+  return Math.ceil((d.getTime() - now.getTime()) / 86_400_000);
+}
+
+/** 单项目一行摘要。 */
+export function formatProjectLine(p: StatusProjectRow, now: Date): string {
+  const stage = STAGE_LABEL[getProjectStage(p)] ?? "未知阶段";
+  const left = daysUntil(resolveCloseDate(p), now);
+  const deadline = left === null ? "无截标日" : left < 0 ? `已过截标 ${-left} 天` : `截标还有 ${left} 天`;
+  const analysis = p.analysisStatus ? ANALYSIS_LABEL[p.analysisStatus] ?? p.analysisStatus : "未分析";
+  const approvals = p.pendingApprovals > 0 ? `，${p.pendingApprovals} 条待你批` : "";
+  return `${p.name}：${stage} · ${deadline} · ${analysis}${approvals}`;
+}
+
+/** 排序：有待批的优先，其次截标最近。 */
+export function sortStatusRows(rows: StatusProjectRow[], now: Date): StatusProjectRow[] {
+  return [...rows].sort((a, b) => {
+    if ((b.pendingApprovals > 0 ? 1 : 0) !== (a.pendingApprovals > 0 ? 1 : 0)) {
+      return b.pendingApprovals > 0 ? 1 : -1;
+    }
+    const da = daysUntil(resolveCloseDate(a), now) ?? Number.POSITIVE_INFINITY;
+    const db_ = daysUntil(resolveCloseDate(b), now) ?? Number.POSITIVE_INFINITY;
+    return da - db_;
+  });
+}
+
+export function formatStatusMessage(rows: StatusProjectRow[], now: Date): { message: string; suggestedActions: MuseSuggestedAction[] } {
+  if (rows.length === 0) {
+    return { message: "当前没有在跟的投标项目。", suggestedActions: [] };
+  }
+  const sorted = sortStatusRows(rows, now);
+  const top = sorted.slice(0, 8);
+  const lines = top.map((p, i) => `${i + 1}. ${formatProjectLine(p, now)}`);
+  const more = sorted.length > top.length ? `\n（还有 ${sorted.length - top.length} 个，问我具体项目名可查看）` : "";
+  const suggestedActions: MuseSuggestedAction[] = top.slice(0, 3).map((p) => ({
+    label: `问「${p.name.slice(0, 20)}」`,
+    command: { intent: "ask", projectId: p.id, question: "这个标现在最需要我做什么？" },
+  }));
+  return { message: `在跟 ${sorted.length} 个标：\n${lines.join("\n")}${more}`, suggestedActions };
+}
+
+// ── approvals ───────────────────────────────────────────────────
+
+export type ApprovalDecisionOutcome = {
+  ok: boolean;
+  status?: string;
+  message?: string;
+  error?: string;
+  duplicate?: boolean;
+};
+
+export function formatApprovalOutcome(
+  requestId: string,
+  decision: "approve" | "reject",
+  outcome: ApprovalDecisionOutcome,
+): MuseCommandResponse {
+  if (!outcome.ok) {
+    return errResponse(requestId, "APPROVAL_FAILED", outcome.error ?? "审批失败，请在青砚审批中心查看。");
+  }
+  const verb = decision === "approve" ? "已批准" : "已驳回";
+  const dup = outcome.duplicate ? "（这条之前已经处理过，本次未重复执行）" : "";
+  const tail = outcome.message ? `，${outcome.message}` : "";
+  return okResponse(requestId, `${verb}${dup}${tail}`, {
+    data: { status: outcome.status ?? null },
+    suggestedActions: [{ label: "看看还有什么要批", command: { intent: "status" } }],
+  });
+}
+
+// ── 意图门 ──────────────────────────────────────────────────────
+
+export function gateIntent(
+  requestId: string,
+  command: MuseCommandArgs,
+  enabled: ReadonlySet<MuseIntent>,
+): MuseCommandResponse | null {
+  return enabled.has(command.intent) ? null : notEnabledResponse(requestId, command.intent);
+}
diff --git a/src/lib/muse-bridge/router.ts b/src/lib/muse-bridge/router.ts
new file mode 100644
index 0000000..6f31d20
--- /dev/null
+++ b/src/lib/muse-bridge/router.ts
@@ -0,0 +1,340 @@
+/**
+ * Muse Bridge — 命令路由（DB 侧）
+ *
+ * 职责边界：
+ *   - 只调用青砚既有服务（ApprovalPort / tender stage / 分析上下文），不新造业务逻辑；
+ *   - 幂等：同 requestId 在 24h 内重放 → 直接返回首次响应（AuditLog 作账本，零 schema）；
+ *   - 所有格式化走 router-pure.ts；本文件只做取数与编排。
+ *   - Phase 0 只实现 status / ask / approve / reject；其余意图由 gateIntent 诚实拒绝。
+ */
+
+import { db } from "@/lib/db";
+import { logAudit, writeAuditLog } from "@/lib/audit/logger";
+import { approveApprovalItem, rejectApprovalItem, listApprovalInbox } from "@/lib/approval/port";
+import { createCompletion } from "@/lib/ai/client";
+import { isAIConfigured } from "@/lib/ai/config";
+import { buildTenderPackageContext } from "@/lib/tender-auto-analysis/chat-context";
+import { museCommandResponseSchema, type MuseCommandArgs, type MuseCommandEnvelope, type MuseCommandResponse } from "./contract";
+import { enabledMuseIntents } from "./flags";
+import type { MuseIdentity } from "./binding-pure";
+import {
+  errResponse,
+  formatApprovalOutcome,
+  formatStatusMessage,
+  gateIntent,
+  okResponse,
+  type StatusProjectRow,
+} from "./router-pure";
+
+const LEDGER_TARGET_TYPE = "muse_bridge_request" as const;
+const LEDGER_WINDOW_MS = 24 * 60 * 60 * 1000;
+
+const TERMINAL_TENDER_STATUSES = ["won", "lost", "passed", "archived"];
+
+// ── 入口 ────────────────────────────────────────────────────────
+
+export async function handleMuseCommand(
+  envelope: MuseCommandEnvelope,
+  identity: MuseIdentity,
+): Promise<MuseCommandResponse> {
+  const { requestId, command } = envelope;
+
+  // 1. 幂等账本
+  const replay = await findLedgerResponse(requestId, identity);
+  if (replay) return replay;
+
+  // 2. 意图门
+  const gated = gateIntent(requestId, command, enabledMuseIntents());
+  if (gated) return await ledger(envelope, identity, gated);
+
+  // 3. 分发
+  let response: MuseCommandResponse;
+  try {
+    switch (command.intent) {
+      case "status":
+        response = await handleStatus(requestId, identity, command.projectId);
+        break;
+      case "ask":
+        response = await handleAsk(requestId, identity, command.projectId, command.question);
+        break;
+      case "approve": {
+        const outcome = await approveApprovalItem("pending_action", command.approvalId, {
+          userId: identity.userId,
+          role: identity.role,
+          orgId: identity.orgId,
+          note: command.note,
+          acceptedWithRisk: command.acceptedWithRisk,
+        });
+        response = formatApprovalOutcome(requestId, "approve", outcome);
+        break;
+      }
+      case "reject": {
+        const outcome = await rejectApprovalItem("pending_action", command.approvalId, {
+          userId: identity.userId,
+          role: identity.role,
+          orgId: identity.orgId,
+          note: command.reason,
+        });
+        response = formatApprovalOutcome(requestId, "reject", outcome);
+        break;
+      }
+      case "rfq":
+        response = await handleRfq(requestId, identity, command);
+        break;
+      default:
+        // gateIntent 已拦；此处仅类型兜底
+        response = errResponse(requestId, "INTENT_NOT_ENABLED", "该动作尚未开放。");
+    }
+  } catch (err) {
+    console.error("[muse-bridge] command failed:", err);
+    response = errResponse(requestId, "INTERNAL", "青砚处理这条指令时出错了，已记录；请稍后再试或在青砚内操作。");
+  }
+
+  return await ledger(envelope, identity, response);
+}
+
+// ── 幂等账本（AuditLog） ─────────────────────────────────────────
+
+async function findLedgerResponse(requestId: string, identity: MuseIdentity): Promise<MuseCommandResponse | null> {
+  const row = await db.auditLog.findFirst({
+    where: {
+      targetType: LEDGER_TARGET_TYPE,
+      targetId: requestId,
+      orgId: identity.orgId,
+      createdAt: { gt: new Date(Date.now() - LEDGER_WINDOW_MS) },
+    },
+    orderBy: { createdAt: "desc" },
+    select: { afterData: true },
+  });
+  if (!row?.afterData) return null;
+  try {
+    const parsed = museCommandResponseSchema.safeParse(JSON.parse(row.afterData));
+    return parsed.success ? parsed.data : null;
+  } catch {
+    return null;
+  }
+}
+
+async function ledger(
+  envelope: MuseCommandEnvelope,
+  identity: MuseIdentity,
+  response: MuseCommandResponse,
+): Promise<MuseCommandResponse> {
+  try {
+    await writeAuditLog(db, {
+      userId: identity.userId,
+      orgId: identity.orgId,
+      projectId: "projectId" in envelope.command ? envelope.command.projectId ?? null : null,
+      action: `muse:${envelope.command.intent}`,
+      targetType: LEDGER_TARGET_TYPE,
+      targetId: envelope.requestId,
+      beforeData: { museUserRef: envelope.museUserRef, command: envelope.command, utterance: envelope.utterance ?? null },
+      afterData: response,
+    });
+  } catch (err) {
+    // 账本失败不影响回复，但要留痕
+    console.error("[muse-bridge] ledger write failed:", err);
+    void logAudit({ userId: identity.userId, orgId: identity.orgId, action: "muse:ledger_failed", targetType: LEDGER_TARGET_TYPE, targetId: envelope.requestId });
+  }
+  return response;
+}
+
+// ── status ──────────────────────────────────────────────────────
+
+async function handleStatus(requestId: string, identity: MuseIdentity, projectId?: string): Promise<MuseCommandResponse> {
+  const projects = await db.project.findMany({
+    where: {
+      orgId: identity.orgId,
+      workDomain: "tender",
+      ...(projectId ? { id: projectId } : { OR: [{ tenderStatus: null }, { tenderStatus: { notIn: TERMINAL_TENDER_STATUSES } }] }),
+    },
+    orderBy: { closeDate: "asc" },
+    take: 50,
+    select: {
+      id: true,
+      name: true,
+      createdAt: true,
+      tenderStatus: true,
+      publicDate: true,
+      questionCloseDate: true,
+      closeDate: true,
+      dueDate: true,
+      distributedAt: true,
+      dispatchedAt: true,
+      interpretedAt: true,
+      supplierInquiredAt: true,
+      supplierQuotedAt: true,
+      submittedAt: true,
+      awardDate: true,
+      intakeStatus: true,
+      sourceMetadataJson: true,
+      tenderAnalysisRuns: { orderBy: { createdAt: "desc" }, take: 1, select: { status: true } },
+    },
+  });
+  if (projectId && projects.length === 0) {
+    return errResponse(requestId, "PROJECT_NOT_FOUND", "没找到这个项目，或它不属于你的组织。");
+  }
+
+  const inbox = await listApprovalInbox(identity.userId);
+  const pendingByProject = new Map<string, number>();
+  for (const item of inbox) {
+    const pid = item.source.projectId;
+    if (pid) pendingByProject.set(pid, (pendingByProject.get(pid) ?? 0) + 1);
+  }
+
+  const iso = (d: Date | null | undefined) => (d ? d.toISOString() : null);
+  const rows: StatusProjectRow[] = projects.map((p) => ({
+    id: p.id,
+    name: p.name,
+    createdAt: iso(p.createdAt),
+    tenderStatus: p.tenderStatus,
+    publicDate: iso(p.publicDate),
+    questionCloseDate: iso(p.questionCloseDate),
+    closeDate: iso(p.closeDate),
+    dueDate: iso(p.dueDate),
+    distributedAt: iso(p.distributedAt),
+    dispatchedAt: iso(p.dispatchedAt),
+    interpretedAt: iso(p.interpretedAt),
+    supplierInquiredAt: iso(p.supplierInquiredAt),
+    supplierQuotedAt: iso(p.supplierQuotedAt),
+    submittedAt: iso(p.submittedAt),
+    awardDate: iso(p.awardDate),
+    intakeStatus: p.intakeStatus,
+    sourceMetadataJson: p.sourceMetadataJson,
+    analysisStatus: p.tenderAnalysisRuns[0]?.status ?? null,
+    pendingApprovals: pendingByProject.get(p.id) ?? 0,
+  }));
+
+  const { message, suggestedActions } = formatStatusMessage(rows, new Date());
+  return okResponse(requestId, message, {
+    data: { projects: rows.map((r) => ({ id: r.id, name: r.name, closeDate: r.closeDate, analysisStatus: r.analysisStatus, pendingApprovals: r.pendingApprovals })) },
+    suggestedActions,
+  });
+}
+
+// ── ask（证据接地问答） ─────────────────────────────────────────
+
+const ASK_SYSTEM = [
+  "你是青砚投标助理，通过 Muse 通道回答用户关于一个投标项目的问题。",
+  "硬规则：",
+  "1. 只能依据下面给出的项目上下文作答；上下文没有写的信息一律回答「文档/分析里没有这一项」，绝不推测、绝不编造。",
+  "2. 涉及是否合规、是否满足强制要求的结论，必须指出依据来自哪条要求或哪页；没有依据就说「无证据，需人工确认」。",
+  "3. 不输出任何内部成本、毛利、估值、预算类信息。",
+  "4. 回答控制在 6 句以内，先给结论，再给依据，最后给一个最该做的下一步。用中文。",
+].join("\n");
+
+async function handleAsk(
+  requestId: string,
+  identity: MuseIdentity,
+  projectId: string,
+  question: string,
+): Promise<MuseCommandResponse> {
+  const project = await db.project.findFirst({
+    where: { id: projectId, orgId: identity.orgId },
+    select: { id: true, name: true, workDomain: true },
+  });
+  if (!project) return errResponse(requestId, "PROJECT_NOT_FOUND", "没找到这个项目，或它不属于你的组织。");
+
+  const context = (await buildTenderPackageContext(projectId)) ?? (await fallbackContext(projectId));
+  if (!context) {
+    return okResponse(requestId, `「${project.name}」还没有可用的分析结果，先上传招标文件并等分析完成，再来问我。`, {
+      suggestedActions: [{ label: "看整体状态", command: { intent: "status" } }],
+    });
+  }
+  if (!isAIConfigured()) {
+    return errResponse(requestId, "INTERNAL", "AI 未配置，暂时无法回答；分析结果可在青砚项目页查看。");
+  }
+
+  const answer = await createCompletion({
+    systemPrompt: `${ASK_SYSTEM}\n\n【项目】${project.name}\n【上下文】\n${context.slice(0, 24_000)}`,
+    userPrompt: question,
+    orgId: identity.orgId,
+    userId: identity.userId,
+    temperature: 0.2,
+    maxTokens: 700,
+    workflow: "muse_bridge_ask",
+  });
+
+  return okResponse(requestId, answer.trim(), {
+    suggestedActions: [
+      { label: "还有什么要批", command: { intent: "status" } },
+      { label: "再问一个", command: { intent: "ask", projectId, question: "这个标最大的废标风险是什么？" } },
+    ],
+  });
+}
+
+/** EXPERIENCE 开关关闭时的最小上下文：最新分析 summaryText + 强制要求列表（仍是 canonical 数据）。 */
+async function fallbackContext(projectId: string): Promise<string | null> {
+  const run = await db.tenderAnalysisRun.findFirst({
+    where: { projectId },
+    orderBy: { createdAt: "desc" },
+    select: {
+      status: true,
+      summaryText: true,
+      requirements: {
+        take: 60,
+        orderBy: { createdAt: "asc" },
+        select: { originalRequirement: true, mandatory: true, complianceStatus: true },
+      },
+    },
+  });
+  if (!run) return null;
+  const reqs = run.requirements
+    .map((r, i) => `${i + 1}. [${r.mandatory ? "强制" : "评分"}|${r.complianceStatus}] ${r.originalRequirement.slice(0, 240)}`)
+    .join("\n");
+  return [`分析状态：${run.status}`, run.summaryText ? `摘要：\n${run.summaryText}` : "摘要：无", reqs ? `要求：\n${reqs}` : "要求：无"].join("\n\n");
+}
+
+// ── rfq（P1-2：准备一轮询价 → 审批卡） ──────────────────────────
+
+async function handleRfq(
+  requestId: string,
+  identity: MuseIdentity,
+  command: Extract<MuseCommandArgs, { intent: "rfq" }>,
+): Promise<MuseCommandResponse> {
+  const { prepareRfqRound } = await import("@/lib/tender-rfq/service");
+  const r = await prepareRfqRound({
+    projectId: command.projectId,
+    orgId: identity.orgId,
+    userId: identity.userId,
+    supplierIds: command.supplierIds,
+    supplierHint: command.supplierHint ?? null,
+    scopeNote: command.scope ?? null,
+  });
+
+  if (!r.ok) {
+    if (r.errorCode === "NO_SUPPLIERS" && r.candidates?.length) {
+      const withEmail = r.candidates.filter((c) => !!c.contactEmail);
+      const list = r.candidates.map((c) => `· ${c.name}${c.contactEmail ? "" : "（无邮箱）"}`).join("\n");
+      return okResponse(requestId, `要问哪几家？最近用过的供应商：\n${list}\n直接说名字，或者说「全部有邮箱的」。`, {
+        data: { candidates: r.candidates },
+        suggestedActions: [
+          ...(withEmail.length
+            ? [{ label: `全部有邮箱的 ${withEmail.length} 家`, command: { intent: "rfq" as const, projectId: command.projectId, supplierIds: withEmail.slice(0, 10).map((c) => c.id) } }]
+            : []),
+          ...withEmail.slice(0, 3).map((c) => ({ label: `只问 ${c.name.slice(0, 12)}`, command: { intent: "rfq" as const, projectId: command.projectId, supplierIds: [c.id] } })),
+        ],
+      });
+    }
+    const code = r.errorCode === "PROJECT_NOT_FOUND" ? "PROJECT_NOT_FOUND" : r.errorCode === "ROUND_LOCKED" ? "APPROVAL_FAILED" : "VALIDATION_FAILED";
+    return errResponse(requestId, code, r.message, {
+      suggestedActions: [{ label: "看这个标的状态", command: { intent: "status", projectId: command.projectId } }],
+    });
+  }
+
