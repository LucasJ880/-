+ok("org 允许名单命中", isMuseOrgAllowed("org_1", { MUSE_BRIDGE_ORG_ALLOWLIST: "org_1,org_2" }));
+ok("org 允许名单未命中 → 拒绝", !isMuseOrgAllowed("org_9", { MUSE_BRIDGE_ORG_ALLOWLIST: "org_1" }));
+
+console.log("muse-bridge binding");
+
+{
